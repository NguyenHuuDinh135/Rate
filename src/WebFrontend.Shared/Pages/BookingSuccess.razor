@page "/booking/success"
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject NavigationManager NavigationManager

<div class="min-h-[80vh] flex flex-col items-center justify-center p-4">
    <div class="w-full max-w-md animate-in fade-in slide-in-from-bottom-8 duration-700">
        
        <div class="relative bg-white rounded-[3rem] shadow-2xl overflow-hidden border border-slate-100">
            @* Ticket Header *@
            <div class="p-8 pb-10 bg-slate-900 text-white text-center relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-accent/20 to-transparent opacity-50"></div>
                
                <div class="relative z-10 space-y-4">
                    <div class="w-16 h-16 bg-accent rounded-full flex items-center justify-center mx-auto shadow-xl shadow-accent/20">
                        <FluentIcon Value="@(new Size32.CheckmarkCircle())" Color="Color.Fill" />
                    </div>
                    <h1 class="text-3xl font-black tracking-tight leading-none uppercase">ĐẶT VÉ THÀNH CÔNG!</h1>
                    <p class="text-white/60 font-bold text-xs uppercase tracking-[0.3em]">Cảm ơn bạn đã sử dụng RATE</p>
                </div>
            </div>

            @* Ticket Tear Line *@
            <div class="relative flex items-center justify-between">
                <div class="w-10 h-10 bg-slate-50 rounded-full -ml-5 shadow-inner"></div>
                <div class="flex-1 border-t-4 border-dashed border-slate-100 mx-2"></div>
                <div class="w-10 h-10 bg-slate-50 rounded-full -mr-5 shadow-inner"></div>
            </div>

            @* Ticket Body *@
            <div class="p-10 space-y-10">
                <div class="grid grid-cols-2 gap-y-8">
                    <div>
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Mã vé</p>
                        <p class="text-xl font-black text-slate-900 tracking-tighter">#RATE-@Id.ToString().PadLeft(6, '0')</p>
                    </div>
                    <div class="text-right">
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Ghế</p>
                        <p class="text-xl font-black text-accent tracking-tighter">@Seats</p>
                    </div>
                    <div>
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Thời gian</p>
                        <p class="text-lg font-bold text-slate-700">19:30, 18 Th12</p>
                    </div>
                    <div class="text-right">
                        <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Rạp</p>
                        <p class="text-lg font-bold text-slate-700">P.04 - Lotte HN</p>
                    </div>
                </div>

                <div class="flex flex-col items-center justify-center p-8 bg-slate-50 rounded-[2rem] border border-slate-100 space-y-4">
                    <div class="p-4 bg-white rounded-2xl shadow-sm border border-slate-100">
                        <FluentIcon Value="@(new Size24.MoviesAndTv())" class="w-32 h-32 text-slate-900" />
                    </div>
                    <p class="text-[9px] text-slate-400 font-black uppercase tracking-[0.2em]">Quét mã để vào phòng chiếu</p>
                </div>

                <div class="flex justify-between items-center px-4">
                    <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Tổng tiền</span>
                    <span class="text-2xl font-black text-slate-900">190.000 đ</span>
                </div>
            </div>
        </div>

        <div class="mt-12 flex flex-col gap-4">
            <FluentButton Appearance="Appearance.Accent" 
                          class="w-full py-8 h-auto text-lg font-black shadow-xl shadow-accent/20 rounded-2xl" 
                          OnClick="@(() => NavigationManager.NavigateTo("/"))">
                QUAY LẠI TRANG CHỦ
            </FluentButton>
            <FluentButton Appearance="Appearance.Stealth" 
                          class="w-full py-4 h-auto text-sm font-bold text-slate-400 hover:text-slate-600"
                          OnClick="@(() => NavigationManager.NavigateTo("/profile"))">
                XEM LỊCH SỬ ĐẶT VÉ
            </FluentButton>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public int Id { get; set; } = 123456;
    [SupplyParameterFromQuery] public string Seats { get; set; } = "A1, A2";
}
