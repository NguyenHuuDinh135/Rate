@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 text-slate-950 transition-colors dark:bg-slate-950 dark:text-slate-50">
    <header class="fixed inset-x-0 top-0 z-20">
        <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5 sm:px-6 lg:px-8">
            <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-900 transition hover:text-red-600 dark:text-slate-100 dark:hover:text-red-400">
                <span class="grid h-8 w-8 place-items-center rounded-full bg-red-600 text-sm font-black text-white shadow-sm shadow-red-600/20">R</span>
                <span>RATE Movie</span>
            </a>
            <ThemeToggle />
        </div>
    </header>

    <main class="min-h-screen px-5 pb-10 pt-20 sm:px-6 lg:px-8">
        @Body
    </main>
</div>
