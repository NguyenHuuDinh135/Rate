@using Fluxor
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Store.Auth
@inherits LayoutComponentBase
@implements IDisposable
@inject IState<AuthState> AuthState
@inject NavigationManager NavigationManager
@inject IAdminThemeService ThemeService

<MudLayout Class="@LayoutClass">
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="MudBlazor.DrawerVariant.Responsive"
               ClipMode="MudBlazor.DrawerClipMode.Never"
               Elevation="0"
               Width="280px"
               Class="rate-admin-drawer">
        <AdminSidebar UserName="@AuthState.Value.User?.Username" />
    </MudDrawer>

    <MudMainContent Class="rate-admin-main">
        <AdminTopbar OnMenuClick="@ToggleDrawer" />
        <main class="rate-admin-content">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private string LayoutClass => ThemeService.IsDarkMode
        ? "rate-admin-layout rate-admin-layout--dark"
        : "rate-admin-layout";

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += HandleThemeChanged;

        if (!AuthState.Value.IsAuthenticated)
        {
            // Preserve current behavior: the redirect is intentionally disabled while admin auth is still being wired.
            // NavigationManager.NavigateTo("/auth/login");
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
    }
}
