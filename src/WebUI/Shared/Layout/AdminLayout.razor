@using Fluxor
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Store.Auth
@inherits Fluxor.Blazor.Web.Components.FluxorLayout
@implements IDisposable
@inject WebUI.Shared.Services.Auth.AuthStateService AuthStateService
@inject NavigationManager NavigationManager
@inject IAdminThemeService ThemeService

<MudLayout Class="@LayoutClass">
    <MudDrawer @bind-Open="_drawerOpen"
               Variant="MudBlazor.DrawerVariant.Responsive"
               ClipMode="MudBlazor.DrawerClipMode.Never"
               Elevation="0"
               Width="244px"
               Class="rate-admin-drawer">
        <AdminSidebar UserName="@AuthStateService.CurrentUser?.UserName" />
    </MudDrawer>

    <MudMainContent Class="rate-admin-main">
        <AdminTopbar OnMenuClick="@ToggleDrawer" />
        <main class="rate-admin-content">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private string LayoutClass => ThemeService.IsDarkMode
        ? "rate-admin-layout rate-admin-layout--dark"
        : "rate-admin-layout";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.ThemeChanged += HandleThemeChanged;

        if (!AuthStateService.IsAuthenticated)
        {
             NavigationManager.NavigateTo("/auth/login");
             return;
        }

        if (!AuthStateService.IsInRole("admin"))
        {
            NavigationManager.NavigateTo("/unauthorized");
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
    }
}
