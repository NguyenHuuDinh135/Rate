@page "/auth/login"
@layout AuthLayout
@rendermode InteractiveAuto
@using Fluxor
@using WebUI.Shared.Store.Auth
@implements IDisposable
@inject IState<AuthState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

<section class="mx-auto flex min-h-[calc(100vh-7rem)] w-full max-w-sm flex-col justify-center">
    <a href="/" class="mb-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-slate-950 dark:text-slate-400 dark:hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
        Trang chủ
    </a>

    <div class="mb-7 text-center">
        <div class="mx-auto mb-4 grid h-11 w-11 place-items-center rounded-xl bg-red-600 text-white shadow-lg shadow-red-600/20">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 1 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 1 0 0-4V9Z" />
                <path d="M13 7v10" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">Đăng nhập RATE</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Tiếp tục đặt vé và quản lý lịch xem phim của bạn.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-300" role="status">
            @StatusMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 dark:border-red-900/70 dark:bg-red-950/40 dark:text-red-300" role="alert">
            @ErrorMessage
        </div>
    }

    <form class="space-y-5" @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
        <div class="space-y-2.5 pt-4">
            <label for="login-email" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Email</label>
            <input id="login-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@example.com"
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-4 focus:ring-red-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500 dark:focus:border-red-500"
                @bind="email"
                @bind:event="oninput" />
        </div>

        <div class="space-y-2.5 pt-4">
            <label for="login-password" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Mật khẩu</label>
            <input id="login-password"
                name="password"
                type="password"
                autocomplete="current-password"
                placeholder="••••••••"
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-4 focus:ring-red-500/15 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500 dark:focus:border-red-500"
                @bind="password"
                @bind:event="oninput" />
        </div>

        <button type="submit"
                disabled="@AuthState.Value.IsLoading"
                class="mt-6 inline-flex h-12 w-full items-center justify-center rounded-xl bg-red-600 px-4 text-sm font-bold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-red-500/25 disabled:pointer-events-none disabled:opacity-60">
            Đăng nhập
        </button>
    </form>

    <div class="my-6 flex items-center gap-3 text-xs font-semibold uppercase text-slate-400">
        <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
        Hoặc
        <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
    </div>

    <div class="space-y-2">
        <a href="/api/auth/external-login?provider=Google" class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-900">
            <span class="font-black text-red-600">G</span>
            Tiếp tục với Google
        </a>
        <a href="/api/auth/external-login?provider=GitHub" class="mt-4 inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-900">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.86 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.37 9.37 0 0 1 12 6.98c.85 0 1.7.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" clip-rule="evenodd" />
            </svg>
            Tiếp tục với GitHub
        </a>
    </div>

    <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
        Chưa có tài khoản?
        <a href="/auth/register" class="font-semibold text-red-600 hover:text-red-700 hover:underline dark:text-red-400 dark:hover:text-red-300">Đăng ký</a>
    </p>
</section>

@code {
    [SupplyParameterFromQuery] public bool? Registered { get; set; }
    [SupplyParameterFromQuery] public bool? PasswordReset { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string email = string.Empty;
    private string password = string.Empty;
    private string? localError;

    private string? StatusMessage => Registered == true
        ? "Tạo tài khoản thành công. Vui lòng đăng nhập."
        : PasswordReset == true
            ? "Mật khẩu đã được cập nhật. Vui lòng đăng nhập lại."
            : null;

    private string? ErrorMessage => localError
        ?? (string.Equals(Error, "ExternalLoginFailed", StringComparison.OrdinalIgnoreCase)
            ? "Không thể đăng nhập bằng nhà cung cấp bên ngoài lúc này."
            : AuthState.Value.Error);

    protected override void OnInitialized()
    {
        if (AuthState.Value.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        AuthState.StateChanged += HandleAuthStateChanged;
    }

    private void HandleLogin()
    {
        localError = null;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            localError = "Vui lòng nhập email và mật khẩu.";
            return;
        }

        Dispatcher.Dispatch(new LoginAction(email.Trim(), password));
    }

    private void HandleAuthStateChanged(object? sender, EventArgs e)
    {
        if (AuthState.Value.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthState.StateChanged -= HandleAuthStateChanged;
    }
}
