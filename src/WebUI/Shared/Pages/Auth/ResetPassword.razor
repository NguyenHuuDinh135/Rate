@page "/auth/reset-password"
@layout AuthLayout
@inject IAuthApi AuthApi
@inject NavigationManager NavigationManager

<section class="mx-auto flex min-h-[calc(100vh-7rem)] w-full max-w-sm flex-col justify-center">
    <a href="/auth/forgot-password" class="mb-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-slate-950 dark:text-slate-400 dark:hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
        Quên mật khẩu
    </a>

    <div class="mb-7 text-center">
        <div class="mx-auto mb-4 grid h-11 w-11 place-items-center rounded-xl bg-red-600 text-white shadow-lg shadow-red-600/20">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3v8Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">Đặt lại mật khẩu</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nhập mã OTP và mật khẩu mới cho tài khoản của bạn.</p>
    </div>

    @if (Sent == true)
    {
        <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm font-medium text-emerald-700 dark:border-emerald-900/70 dark:bg-emerald-950/40 dark:text-emerald-300" role="status">
            Nếu email tồn tại, mã đặt lại đã được gửi đến hộp thư của bạn.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 dark:border-red-900/70 dark:bg-red-950/40 dark:text-red-300" role="alert">
            @errorMessage
        </div>
    }

    <form class="space-y-4" @onsubmit="HandleResetPassword" @onsubmit:preventDefault="true">
        <div class="space-y-2">
            <label for="reset-email" class="text-sm font-semibold text-slate-800 dark:text-slate-200">Email</label>
            <input id="reset-email"
                   name="email"
                   type="email"
                   autocomplete="email"
                   placeholder="name@example.com"
                   disabled="@(!string.IsNullOrWhiteSpace(Email))"
                   class="h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-500 dark:disabled:bg-slate-900"
                   @bind="email"
                   @bind:event="oninput" />
        </div>

        <div class="space-y-2">
            <label for="reset-token" class="text-sm font-semibold text-slate-800 dark:text-slate-200">Mã OTP</label>
            <input id="reset-token"
                   name="resetToken"
                   type="text"
                   inputmode="numeric"
                   maxlength="6"
                   placeholder="123456"
                   class="h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-500"
                   @bind="resetToken"
                   @bind:event="oninput" />
        </div>

        <div class="space-y-2">
            <label for="reset-password" class="text-sm font-semibold text-slate-800 dark:text-slate-200">Mật khẩu mới</label>
            <input id="reset-password"
                   name="newPassword"
                   type="password"
                   autocomplete="new-password"
                   placeholder="••••••••"
                   class="h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-500"
                   @bind="newPassword"
                   @bind:event="oninput" />
        </div>

        <div class="space-y-2">
            <label for="reset-confirm-password" class="text-sm font-semibold text-slate-800 dark:text-slate-200">Nhập lại mật khẩu mới</label>
            <input id="reset-confirm-password"
                   name="confirmPassword"
                   type="password"
                   autocomplete="new-password"
                   placeholder="••••••••"
                   class="h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-500"
                   @bind="confirmPassword"
                   @bind:event="oninput" />
        </div>

        <button type="submit"
                disabled="@isLoading"
                class="inline-flex h-11 w-full items-center justify-center rounded-lg bg-red-600 px-4 text-sm font-bold text-white shadow-sm shadow-red-600/20 transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-60 dark:ring-offset-slate-950">
            @if (isLoading)
            {
                <svg class="mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z" />
                </svg>
            }
            Cập nhật mật khẩu
        </button>
    </form>
</section>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    [SupplyParameterFromQuery] public bool? Sent { get; set; }

    private string email = string.Empty;
    private string resetToken = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? errorMessage;
    private bool isLoading;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            email = Email;
        }

        if (!string.IsNullOrWhiteSpace(Token))
        {
            resetToken = Token;
        }
    }

    private async Task HandleResetPassword()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(resetToken) || string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessage = "Vui lòng nhập email, mã OTP và mật khẩu mới.";
            return;
        }

        if (newPassword.Length < 6)
        {
            errorMessage = "Mật khẩu mới cần tối thiểu 6 ký tự.";
            return;
        }

        if (!string.Equals(newPassword, confirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "Mật khẩu nhập lại không khớp.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await AuthApi.ResetPasswordAsync(new ResetPasswordRequest(email.Trim(), resetToken.Trim(), newPassword));
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/auth/login?passwordReset=true");
                return;
            }

            errorMessage = "Mã OTP không hợp lệ hoặc đã hết hạn.";
        }
        catch
        {
            errorMessage = "Không thể đặt lại mật khẩu lúc này. Vui lòng thử lại sau.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
