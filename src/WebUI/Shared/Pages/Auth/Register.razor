@page "/auth/register"
@layout AuthLayout
@rendermode InteractiveWebAssembly
@using Fluxor
@using WebUI.Shared.Store.Auth
@inject IAuthApi AuthApi
@inject IState<AuthState> AuthState
@inject NavigationManager NavigationManager

<section class="mx-auto flex min-h-[calc(100vh-7rem)] w-full max-w-sm flex-col justify-center">
    <a href="/auth/login" class="mb-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-slate-950 dark:text-slate-400 dark:hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
        Đăng nhập
    </a>

    <div class="mb-7 text-center">
        <div class="mx-auto mb-4 grid h-11 w-11 place-items-center rounded-xl bg-red-600 text-white shadow-lg shadow-red-600/20">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 1 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 1 0 0-4V9Z" />
                <path d="M13 7v10" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">Tạo tài khoản</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Đăng ký để đặt vé và theo dõi lịch xem phim.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 dark:border-red-900/70 dark:bg-red-950/40 dark:text-red-300" role="alert">
            @errorMessage
        </div>
    }

    <form class="space-y-5" @onsubmit="HandleRegister" @onsubmit:preventDefault="true">
        <div class="space-y-2.5 pt-4">
            <label for="register-full-name" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Họ tên</label>
            <input id="register-full-name"
                name="fullName"
                type="text"
                autocomplete="name"
                placeholder="Nguyễn Văn A"
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-4 focus:ring-red-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500 dark:focus:border-red-500"
                @bind="fullName"
                @bind:event="oninput" />
        </div>

        <div class="space-y-2.5 pt-4">
            <label for="register-email" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Email</label>
            <input id="register-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="name@example.com"
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-4 focus:ring-red-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500 dark:focus:border-red-500"
                @bind="email"
                @bind:event="oninput" />
        </div>

        <div class="space-y-2.5 pt-4">
            <label for="register-password" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Mật khẩu</label>
            <input id="register-password"
                name="password"
                type="password"
                autocomplete="new-password"
                placeholder="••••••••"
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-4 focus:ring-red-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500 dark:focus:border-red-500"
                @bind="password"
                @bind:event="oninput" />
        </div>

        <div class="space-y-2.5 pt-4">
            <label for="register-confirm-password" class="block text-sm font-semibold text-slate-800 dark:text-slate-200">Nhập lại mật khẩu</label>
            <input id="register-confirm-password"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                placeholder="••••••••"
                class="mt-2 block h-12 w-full rounded-xl border border-slate-300 bg-white px-4 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-4 focus:ring-red-500/15 dark:border-slate-600 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500 dark:focus:border-red-500"
                @bind="confirmPassword"
                @bind:event="oninput" />
        </div>

        <button type="submit"
                disabled="@isLoading"
                class="mt-6 inline-flex h-12 w-full items-center justify-center rounded-xl bg-red-600 px-4 text-sm font-bold text-white shadow-lg shadow-red-600/20 transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-red-500/25 disabled:pointer-events-none disabled:opacity-60">
            @if (isLoading)
            {
                <svg class="mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z" />
                </svg>
            }
            Đăng ký
        </button>
    </form>

    <div class="my-6 flex items-center gap-3 text-xs font-semibold uppercase text-slate-400">
        <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
        Hoặc
        <span class="h-px flex-1 bg-slate-200 dark:bg-slate-800"></span>
    </div>

    <a href="/api/auth/external-login?provider=Google" class="inline-flex h-11 w-full items-center justify-center gap-2 rounded-lg border border-slate-200 bg-white px-4 text-sm font-semibold text-slate-800 transition hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-950 dark:text-slate-100 dark:hover:bg-slate-900">
        <span class="font-black text-red-600">G</span>
        Tiếp tục với Google
    </a>

    <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
        Đã có tài khoản?
        <a href="/auth/login" class="font-semibold text-red-600 hover:text-red-700 hover:underline dark:text-red-400 dark:hover:text-red-300">Đăng nhập</a>
    </p>
</section>

@code {
    private string fullName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string? errorMessage;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (AuthState.Value.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Vui lòng nhập đầy đủ thông tin đăng ký.";
            return;
        }

        if (password.Length < 6)
        {
            errorMessage = "Mật khẩu cần tối thiểu 6 ký tự.";
            return;
        }

        if (!string.Equals(password, confirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "Mật khẩu nhập lại không khớp.";
            return;
        }

        isLoading = true;

        try
        {
            var result = await AuthApi.RegisterAsync(new RegisterRequest(fullName.Trim(), email.Trim(), password));
            if (result.Succeeded)
            {
                NavigationManager.NavigateTo("/auth/login?registered=true");
                return;
            }

            errorMessage = "Không thể tạo tài khoản với thông tin này.";
        }
        catch
        {
            errorMessage = "Không thể tạo tài khoản lúc này. Vui lòng thử lại sau.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
