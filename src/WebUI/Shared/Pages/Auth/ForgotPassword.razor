@page "/auth/forgot-password"
@layout AuthLayout
@rendermode InteractiveWebAssembly
@inject IAuthApi AuthApi
@inject NavigationManager NavigationManager

<section class="mx-auto flex min-h-[calc(100vh-7rem)] w-full max-w-sm flex-col justify-center">
    <a href="/auth/login" class="mb-7 inline-flex w-fit items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-slate-950 dark:text-slate-400 dark:hover:text-white">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6" />
        </svg>
        Đăng nhập
    </a>

    <div class="mb-7 text-center">
        <div class="mx-auto mb-4 grid h-11 w-11 place-items-center rounded-xl bg-red-600 text-white shadow-lg shadow-red-600/20">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 13a8 8 0 1 1 15.45 2.9" />
                <path d="M12 7v5l3 2" />
                <path d="m19 19 2 2" />
                <path d="m21 19-2 2" />
            </svg>
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-950 dark:text-white">Quên mật khẩu</h1>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Nhập email tài khoản để nhận mã đặt lại mật khẩu.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm font-medium text-red-700 dark:border-red-900/70 dark:bg-red-950/40 dark:text-red-300" role="alert">
            @errorMessage
        </div>
    }

    <form class="space-y-4" @onsubmit="HandleForgotPassword" @onsubmit:preventDefault="true">
        <div class="space-y-2">
            <label for="forgot-email" class="text-sm font-semibold text-slate-800 dark:text-slate-200">Email</label>
            <input id="forgot-email"
                   name="email"
                   type="email"
                   autocomplete="email"
                   placeholder="name@example.com"
                   class="h-11 w-full rounded-lg border border-slate-200 bg-white px-3 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 dark:border-slate-800 dark:bg-slate-950 dark:text-white dark:placeholder:text-slate-500"
                   @bind="email"
                   @bind:event="oninput" />
        </div>

        <button type="submit"
                disabled="@isLoading"
                class="inline-flex h-11 w-full items-center justify-center rounded-lg bg-red-600 px-4 text-sm font-bold text-white shadow-sm shadow-red-600/20 transition hover:bg-red-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-60 dark:ring-offset-slate-950">
            @if (isLoading)
            {
                <svg class="mr-2 h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4Z" />
                </svg>
            }
            Gửi mã đặt lại
        </button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-500 dark:text-slate-400">
        Đã nhớ mật khẩu?
        <a href="/auth/login" class="font-semibold text-red-600 hover:text-red-700 hover:underline dark:text-red-400 dark:hover:text-red-300">Đăng nhập</a>
    </p>
</section>

@code {
    private string email = string.Empty;
    private string? errorMessage;
    private bool isLoading;

    private async Task HandleForgotPassword()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Vui lòng nhập email tài khoản.";
            return;
        }

        isLoading = true;

        try
        {
            await AuthApi.ForgotPasswordAsync(new ForgotPasswordRequest(email.Trim()));
            NavigationManager.NavigateTo($"/auth/reset-password?email={Uri.EscapeDataString(email.Trim())}&sent=true");
        }
        catch
        {
            errorMessage = "Không thể gửi mã đặt lại lúc này. Vui lòng thử lại sau.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
