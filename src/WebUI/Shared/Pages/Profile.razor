@page "/profile"
@using Fluxor
@using WebUI.Shared.Store.Auth
@using WebUI.Shared.Models.Payments
@using WebUI.Shared.Services.Api
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject IState<AuthState> AuthState
@inject IDispatcher Dispatcher
@inject IPaymentApi PaymentApi
@inject IUserApi UserApi
@inject IAuthApi AuthApi
@inject IToastService ToastService
@inject NavigationManager NavigationManager

<div class="min-h-screen bg-slate-50 pt-24 pb-20 px-4">
    <div class="container mx-auto max-w-6xl">
        @if (showSettings)
        {
            <div class="space-y-8 animate-in fade-in slide-in-from-bottom-4">
                <div class="flex items-center gap-4">
                    <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Size24.ArrowLeft())" OnClick="@(() => showSettings = false)">Quay lại hồ sơ</FluentButton>
                    <h2 class="text-3xl font-black tracking-tight text-slate-900">Cài đặt tài khoản</h2>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <FluentCard class="p-8 rounded-[2rem] shadow-sm border border-slate-100 bg-white">
                        <h3 class="text-xl font-bold mb-6">Thông tin cá nhân</h3>
                        <div class="space-y-4">
                            <FluentTextField @bind-Value="editUsername" Label="Tên hiển thị" class="w-full" />
                            <FluentTextField @bind-Value="editEmail" Label="Email" class="w-full" />
                            <FluentButton Appearance="Appearance.Accent" class="w-full mt-4" Loading="@isUpdatingProfile" OnClick="HandleUpdateProfile">Lưu thay đổi</FluentButton>
                        </div>
                    </FluentCard>
                    
                    <FluentCard class="p-8 rounded-[2rem] shadow-sm border border-slate-100 bg-white">
                        <h3 class="text-xl font-bold mb-6">Đổi mật khẩu</h3>
                        <div class="space-y-4">
                            <FluentTextField @bind-Value="currentPassword" TextFieldType="TextFieldType.Password" Label="Mật khẩu hiện tại" class="w-full" />
                            <FluentTextField @bind-Value="newPassword" TextFieldType="TextFieldType.Password" Label="Mật khẩu mới" class="w-full" />
                            <FluentTextField @bind-Value="confirmPassword" TextFieldType="TextFieldType.Password" Label="Xác nhận mật khẩu mới" class="w-full" />
                            <FluentButton Appearance="Appearance.Accent" class="w-full mt-4" Loading="@isChangingPassword" OnClick="HandleChangePassword">Đổi mật khẩu</FluentButton>
                        </div>
                    </FluentCard>
                </div>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 animate-in fade-in slide-in-from-bottom-4">
                @* User Profile Card *@
                <div class="lg:col-span-4 space-y-6">
                    <FluentCard class="p-0 rounded-[3rem] shadow-xl border-none bg-white overflow-hidden">
                        <div class="h-32 bg-slate-900 relative">
                            <div class="absolute inset-0 bg-gradient-to-br from-accent/40 to-transparent opacity-50"></div>
                        </div>
                        <div class="p-10 pt-0 text-center relative">
                            <div class="w-32 h-32 rounded-[2.5rem] bg-white border-[6px] border-white shadow-2xl mx-auto -mt-16 mb-6 flex items-center justify-center overflow-hidden">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(currentUser?.UserName ?? AuthState.Value.User?.Username ?? "User")" class="w-full h-full object-cover" alt="Avatar" />
                            </div>
                            <h2 class="text-3xl font-black text-slate-900 tracking-tight">@(currentUser?.UserName ?? AuthState.Value.User?.Username)</h2>
                            <p class="text-slate-400 font-bold text-sm mt-1">@(currentUser?.Email ?? AuthState.Value.User?.Email)</p>

                            <div class="grid grid-cols-2 gap-4 mt-10">
                                <div class="p-4 bg-slate-50 rounded-3xl border border-slate-100">
                                    <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Tổng chi</p>
                                    <p class="text-xl font-black text-accent">@(totalSpent.ToString("N0")) đ</p>
                                </div>
                                <div class="p-4 bg-slate-50 rounded-3xl border border-slate-100">
                                    <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mb-1">Số vé</p>
                                    <p class="text-xl font-black text-slate-900">@(payments.Count)</p>
                                </div>
                            </div>

                            <div class="mt-10 pt-10 border-t border-slate-100 flex flex-col gap-3">
                                <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Size20.Settings())" class="w-full h-12 rounded-xl font-bold" OnClick="@(() => showSettings = true)">Cài đặt tài khoản</FluentButton>
                                <FluentButton Appearance="Appearance.Neutral" IconStart="@(new Size20.SignOut())" class="w-full h-12 rounded-xl font-bold text-error" OnClick="@HandleLogout">Đăng xuất</FluentButton>
                            </div>
                        </div>
                    </FluentCard>
                </div>

                @* History Section *@
                <div class="lg:col-span-8 space-y-8">
                    <div class="flex items-center justify-between">
                        <h2 class="text-3xl font-black tracking-tight text-slate-900">Giao dịch gần đây</h2>
                        <FluentBadge Appearance="Appearance.Lightweight" class="h-8 px-4 font-bold">@(payments.Count) Đơn hàng</FluentBadge>
                    </div>

                    <div class="flex flex-col gap-6">
                        @if (isLoading)
                        {
                            @for (int i = 0; i < 3; i++)
                            {
                                <FluentSkeleton class="h-40 w-full rounded-[2.5rem]" />
                            }
                        }
                        else if (payments.Any())
                        {
                            @foreach (var payment in payments)
                            {
                                <div class="bg-white p-6 rounded-[2rem] shadow-sm border border-slate-100 flex items-center justify-between group hover:shadow-md transition-shadow cursor-pointer">
                                    <div class="flex items-center gap-6">
                                        <div class="w-16 h-16 rounded-2xl bg-slate-50 flex items-center justify-center text-slate-300">
                                            <FluentIcon Value="@(new Size24.MoviesAndTv())" />
                                        </div>
                                        <div>
                                            <h4 class="font-black text-slate-900">@(payment.Movie?.Title ?? "Vé xem phim")</h4>
                                            <p class="text-xs text-slate-400 font-bold">@(FormatDate(payment.PaymentDatetime)) • @(payment.PaymentMethod == 1 ? "MOMO" : "TIỀN MẶT")</p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="font-black text-xl text-slate-900">@payment.Amount.ToString("N0") đ</p>
                                        <span class="text-[10px] font-black text-emerald-500 uppercase tracking-widest">Hoàn tất</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="p-20 text-center bg-white rounded-[3rem] border-2 border-dashed border-slate-100">
                                <p class="text-slate-300 font-bold">Chưa có lịch sử giao dịch.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<PaymentDto> payments = new();
    private bool isLoading = true;
    private decimal totalSpent = 0;
    private AuthUserDto? currentUser = null;

    private bool showSettings = false;
    private string editUsername = "";
    private string editEmail = "";
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private bool isUpdatingProfile = false;
    private bool isChangingPassword = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            currentUser = await UserApi.GetMeAsync();
            if (currentUser != null)
            {
                editUsername = currentUser.UserName;
                editEmail = currentUser.Email;
                
                var res = await PaymentApi.GetByUserAsync(currentUser.Id);
                payments = res?.Body ?? new List<PaymentDto>();
                totalSpent = payments.Sum(p => p.Amount);
            }
        }
        catch (Exception) { }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdateProfile()
    {
        if (string.IsNullOrWhiteSpace(editUsername) || string.IsNullOrWhiteSpace(editEmail))
        {
            ToastService.ShowError("Vui lòng điền đầy đủ thông tin.");
            return;
        }
        
        isUpdatingProfile = true;
        try
        {
            var result = await UserApi.UpdateMeAsync(new UpdateMeRequest(editUsername, editEmail));
            if (result.Succeeded)
            {
                ToastService.ShowSuccess("Cập nhật thông tin thành công.");
                if (currentUser != null)
                {
                    currentUser = currentUser with { UserName = editUsername, Email = editEmail };
                }
            }
            else
            {
                ToastService.ShowError(string.Join(", ", result.Errors ?? new[] { "Có lỗi xảy ra" }));
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("Có lỗi xảy ra khi cập nhật thông tin.");
        }
        finally
        {
            isUpdatingProfile = false;
        }
    }

    private async Task HandleChangePassword()
    {
        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword))
        {
            ToastService.ShowError("Vui lòng nhập mật khẩu.");
            return;
        }
        if (newPassword != confirmPassword)
        {
            ToastService.ShowError("Mật khẩu xác nhận không khớp.");
            return;
        }
        
        isChangingPassword = true;
        try
        {
            var result = await AuthApi.ChangePasswordAsync(new ChangePasswordRequest(currentPassword, newPassword));
            if (result.Succeeded)
            {
                ToastService.ShowSuccess("Đổi mật khẩu thành công.");
                currentPassword = "";
                newPassword = "";
                confirmPassword = "";
            }
            else
            {
                ToastService.ShowError(string.Join(", ", result.Errors ?? new[] { "Có lỗi xảy ra" }));
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("Có lỗi xảy ra khi đổi mật khẩu.");
        }
        finally
        {
            isChangingPassword = false;
        }
    }

    private string FormatDate(string dateStr)
    {
        if (DateTime.TryParse(dateStr, out var d))
        {
            return d.ToString("dd/MM/yyyy HH:mm");
        }
        return dateStr;
    }

    private void HandleLogout()
    {
        Dispatcher.Dispatch(new LogoutAction());
        NavigationManager.NavigateTo("/");
    }
}