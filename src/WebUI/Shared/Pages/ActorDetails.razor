@page "/actors/{Id:int}"
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using WebUI.Shared.Models.Movies
@using WebUI.Shared.Services.Api
@inject IPersonApi PersonApi
@inject IToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>Thông tin diễn viên | RATE</PageTitle>

<div class="min-h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black text-white pt-28 pb-24 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-6xl">
        
        @* Breadcrumb / Back Link *@
        <div class="mb-8 flex items-center">
            <button class="flex items-center gap-2 text-xs font-black text-slate-450 hover:text-accent uppercase tracking-widest transition-colors duration-300 bg-transparent border-none cursor-pointer focus:outline-none"
                    @onclick="GoBack">
                <FluentIcon Value="@(new Size16.ChevronLeft())" Color="Color.Fill" />
                <span>QUAY LẠI</span>
            </button>
        </div>

        @if (isLoading)
        {
            <div class="flex flex-col items-center justify-center min-h-[50vh] gap-4">
                <div class="w-12 h-12 rounded-full border-4 border-accent border-t-transparent animate-spin"></div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-500 animate-pulse">Đang tải thông tin diễn viên...</p>
            </div>
        }
        else if (actor == null)
        {
            <div class="flex flex-col items-center justify-center py-24 bg-slate-950/40 rounded-[2.5rem] border border-dashed border-slate-900 text-center gap-4">
                <div class="w-16 h-16 rounded-full bg-slate-900 flex items-center justify-center text-slate-650">
                    <FluentIcon Value="@(new Size32.Person())" Color="Color.Neutral" />
                </div>
                <div class="space-y-1">
                    <h3 class="text-lg font-black text-slate-400">Không tìm thấy diễn viên</h3>
                    <p class="text-slate-650 text-xs font-bold">Dữ liệu diễn viên hiện tại không tồn tại trong hệ thống.</p>
                </div>
                <a href="/" class="mt-2 px-6 py-2.5 bg-accent hover:bg-accent-hover text-white text-xs font-black rounded-xl shadow-md shadow-accent/15 transition-all active:scale-95">Quay lại trang chủ</a>
            </div>
        }
        else
        {
            @* --- ACTOR LAYOUT GRID --- *@
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
                
                @* Left Column: Profile image & info *@
                <div class="lg:col-span-4 sticky top-24 space-y-6">
                    <div class="relative w-full aspect-[3/4] overflow-hidden rounded-[2.5rem] border border-slate-900 bg-gradient-to-b from-slate-900 to-slate-950 shadow-2xl">
                        
                        @* Fallback Placeholder *@
                        <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center select-none bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
                            <span class="text-4xl select-none mb-3">👤</span>
                            <span class="text-lg font-black text-white/95 uppercase line-clamp-2 px-4">@actor.FullName</span>
                        </div>

                        @* Profile Picture *@
                        @if (!string.IsNullOrEmpty(actor.PictureUrl))
                        {
                            <img src="@actor.PictureUrl" 
                                 onerror="this.style.opacity='0';"
                                 class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-500" 
                                 alt="@actor.FullName" />
                        }
                    </div>

                    @* Details Meta Card *@
                    <div class="bg-slate-950/60 backdrop-blur-md border border-slate-900 rounded-[2rem] p-6 shadow-xl space-y-4">
                        <h4 class="text-sm font-black text-white uppercase tracking-widest border-b border-slate-900 pb-2.5">
                            📊 Thông tin chi tiết
                        </h4>
                        <div class="space-y-3.5">
                            @if (actor.Age.HasValue)
                            {
                                <div class="flex justify-between text-xs font-bold">
                                    <span class="text-slate-500 uppercase tracking-wider">Tuổi</span>
                                    <span class="text-slate-200">@actor.Age.Value tuổi</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(actor.DateOfBirth))
                            {
                                <div class="flex justify-between text-xs font-bold">
                                    <span class="text-slate-500 uppercase tracking-wider">Ngày sinh</span>
                                    <span class="text-slate-200">@actor.DateOfBirth</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(actor.PlaceOfBirth))
                            {
                                <div class="flex justify-between text-xs font-bold gap-4 text-right">
                                    <span class="text-slate-500 uppercase tracking-wider shrink-0">Nơi sinh</span>
                                    <span class="text-slate-200 truncate">@actor.PlaceOfBirth</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Right Column: Name, Bio, Movie Filmography *@
                <div class="lg:col-span-8 flex flex-col gap-10">
                    <div class="space-y-5">
                        <span class="px-4 py-1.5 bg-accent/15 border border-accent/25 text-accent text-[10px] font-black rounded-full uppercase tracking-widest">
                            DIỄN VIÊN ĐIỆN ẢNH
                        </span>
                        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white uppercase">@actor.FullName</h1>
                        
                        @* Biography *@
                        <div class="pt-4 border-t border-slate-900/60">
                            <h3 class="text-lg font-black text-white uppercase tracking-wider mb-3">Tiểu sử</h3>
                            <p class="text-slate-300 text-sm leading-relaxed font-semibold">
                                @(string.IsNullOrEmpty(actor.Biography) ? "Thông tin tiểu sử của diễn viên hiện đang được cập nhật." : actor.Biography)
                            </p>
                        </div>
                    </div>

                    @* --- FEATURED MOVIES / FILMOGRAPHY --- *@
                    <div class="pt-8 border-t border-slate-900/60 space-y-6">
                        <h3 class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight flex items-center gap-3">
                            🎥 Tác phẩm đã tham gia
                        </h3>

                        @if (isMoviesLoading)
                        {
                            <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 animate-pulse">
                                @for (int i = 0; i < 3; i++)
                                {
                                    <div class="flex flex-col gap-3">
                                        <div class="aspect-[2/3] bg-slate-900 rounded-cinema"></div>
                                        <div class="h-5 bg-slate-900 rounded w-3/4"></div>
                                    </div>
                                }
                            </div>
                        }
                        else if (movies.Any())
                        {
                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
                                @foreach (var m in movies)
                                {
                                    <div class="group relative flex flex-col gap-3 transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer"
                                         @onclick="@(() => NavigationManager.NavigateTo($"/movies/{m.Id}"))">
                                         
                                        <div class="relative aspect-[2/3] overflow-hidden rounded-cinema border border-slate-200 dark:border-slate-900 bg-gradient-to-b from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-950 shadow-lg group-hover:shadow-[0_0_20px_rgba(229,9,20,0.1)] transition-all duration-500">
                                            @* Poster Image *@
                                            <img src="@m.PosterUrl" 
                                                 onerror="this.style.opacity='0';"
                                                 class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-750 group-hover:scale-105 select-none" 
                                                 alt="@m.Title" />
                                            
                                            @* Hover Info Overlay *@
                                            <div class="absolute inset-0 z-20 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-end p-3">
                                                <span class="w-full h-9 bg-accent hover:bg-accent-hover text-white text-[10px] font-black rounded-lg flex items-center justify-center transition-all duration-300 transform translate-y-1 group-hover:translate-y-0">XEM CHI TIẾT</span>
                                            </div>
                                            
                                            @if (m.Rating.HasValue)
                                            {
                                                <div class="absolute top-2.5 left-2.5 z-30 bg-black/60 backdrop-blur-md text-white px-2 py-0.5 rounded-lg text-[9px] font-black flex items-center gap-1 border border-white/10 shadow-md">
                                                    <FluentIcon Value="@(new Size16.Star())" Color="Color.Warning" />
                                                    <span>@m.Rating</span>
                                                </div>
                                            }
                                        </div>
                                        
                                        <div class="px-1 text-left">
                                            <h4 class="font-black text-xs sm:text-sm leading-snug text-slate-250 line-clamp-2 group-hover:text-accent transition-colors duration-300 h-9 flex items-center">
                                                @m.Title
                                            </h4>
                                            <p class="text-slate-500 text-[10px] font-bold mt-1 uppercase tracking-wider">
                                                Năm @m.Year
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-col items-center justify-center py-14 bg-slate-950/40 rounded-[2.5rem] border border-dashed border-slate-900 text-center gap-3">
                                <div class="w-12 h-12 rounded-full bg-slate-900 flex items-center justify-center text-slate-650">
                                    <FluentIcon Value="@(new Size20.MoviesAndTv())" Color="Color.Neutral" />
                                </div>
                                <p class="text-slate-500 font-bold text-xs">Chưa tìm thấy tác phẩm phim nào tham gia.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private PersonDto? actor;
    private List<MovieDto> movies = new();
    private bool isLoading = true;
    private bool isMoviesLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        
        try
        {
            isLoading = true;
            isMoviesLoading = true;
            
            // 1. Fetch Person Details
            var personResponse = await PersonApi.GetByIdAsync(Id);
            actor = personResponse?.Body;

            // 2. Fetch Movies featuring this Person
            var moviesResponse = await PersonApi.GetMoviesAsync(Id);
            movies = moviesResponse?.Body ?? new List<MovieDto>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi khi tải thông tin diễn viên: " + ex.Message);
        }
        finally
        {
            isLoading = false;
            isMoviesLoading = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/");
    }
}
