@page "/"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using Fluxor
@using WebUI.Shared.Store.Movies
@using WebUI.Shared.Models.Common
@using WebUI.Shared.Models.Movies
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@implements IDisposable
@inject IState<MovieState> MovieState
@inject IDispatcher Dispatcher
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Trang chủ | RATE Movie</PageTitle>

<div class="flex flex-col gap-16 pb-16">
    @if (!string.IsNullOrEmpty(MovieState.Value.Error))
    {
        <div class="container mx-auto mt-8">
            <div class="p-4 bg-red-500/10 border border-red-500/20 rounded-2xl text-red-500 flex flex-col gap-2">
                <div class="flex items-center gap-2 font-black uppercase tracking-widest text-xs">
                    <FluentIcon Value="@(new Size20.ErrorCircle())" Color="Color.Fill" />
                    <span>LỖI KẾT NỐI</span>
                </div>
                <p class="text-sm">@MovieState.Value.Error</p>
                <button class="w-fit px-4 py-2 bg-red-500 text-white rounded-xl text-xs font-black mt-2 hover:bg-red-600 transition-colors"
                        @onclick="@(() => Dispatcher.Dispatch(new LoadMoviesAction()))">
                    THỬ LẠI
                </button>
            </div>
        </div>
    }

    @* --- ACTIVE FILTERS BADGES --- *@
    @if (!string.IsNullOrEmpty(Genre) || !string.IsNullOrEmpty(Search))
    {
        <div class="container mx-auto">
            <div class="flex flex-wrap items-center gap-3 p-4 bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/50 dark:border-slate-800/80 backdrop-blur-md rounded-3xl w-fit">
                @if (!string.IsNullOrEmpty(Genre))
                {
                    <span class="px-3.5 py-1.5 bg-accent/10 border border-accent/20 text-accent text-xs font-black rounded-2xl uppercase tracking-widest flex items-center gap-2">
                        <span>Thể loại: @Genre</span>
                        <button class="hover:text-red-500 font-bold focus:outline-none transition-colors" @onclick="@(() => ClearFilter(true))">✕</button>
                    </span>
                }
                @if (!string.IsNullOrEmpty(Search))
                {
                    <span class="px-3.5 py-1.5 bg-accent/10 border border-accent/20 text-accent text-xs font-black rounded-2xl uppercase tracking-widest flex items-center gap-2">
                        <span>Tìm kiếm: "@Search"</span>
                        <button class="hover:text-red-500 font-bold focus:outline-none transition-colors" @onclick="@(() => ClearFilter(false))">✕</button>
                    </span>
                }
                <button class="text-xs text-slate-500 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white font-black uppercase tracking-widest px-2.5 transition-colors focus:outline-none" @onclick="@(() => NavigationManager.NavigateTo("/"))">
                    ✕ XÓA LỌC HẾT
                </button>
            </div>
        </div>
    }


    @* --- DYNAMIC HERO SLIDESHOW CAROUSEL (HOT MOVIES) --- *@
    @if (hotMovies.Any() && string.IsNullOrEmpty(Search))
    {
        var activeMovie = hotMovies[_currentSlideIndex];
        <section class="relative w-full h-[450px] sm:h-[550px] rounded-[2rem] overflow-hidden shadow-2xl border border-slate-900 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black">
            
            @* Overlapping Backgrounds for Smooth Crossfade *@
            @for (int index = 0; index < hotMovies.Count; index++)
            {
                var movie = hotMovies[index];
                var isActive = index == _currentSlideIndex;
                <div class="absolute inset-0 transition-all duration-1000 ease-in-out transform @(isActive ? "opacity-60 scale-100 pointer-events-auto" : "opacity-0 scale-105 pointer-events-none")">
                    
                    @* Premium crisp poster backdrop *@
                    <img src="@movie.PosterUrl" 
                         onerror="this.style.opacity='0';"
                         class="w-full h-full object-cover scale-100" alt="" />
                         
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/65 to-transparent"></div>
                </div>
            }

            @* Slide Content (Perfect Vertical Centering & Balanced Padding) *@
            <div class="absolute inset-0 z-10 container mx-auto px-6 sm:px-16 lg:px-20 flex flex-col justify-center text-left pb-4">
                <div class="max-w-3xl space-y-5 sm:space-y-6">
                    <div class="flex flex-wrap items-center gap-2 hero-animate">
                        <span class="px-3 py-1 bg-accent/20 border border-accent/30 text-accent text-[10px] font-black rounded-full uppercase tracking-widest">
                            🔥 HOT MOVIE
                        </span>
                        @foreach (var genre in activeMovie.Genres.Take(3))
                        {
                            <span class="px-3 py-1 bg-white/10 backdrop-blur-md text-white text-[10px] font-black rounded-full uppercase tracking-widest border border-white/10">
                                @genre.Name
                            </span>
                        }
                        @if (activeMovie.Rating.HasValue)
                        {
                            <span class="flex items-center gap-1 px-3 py-1 bg-yellow-500 text-black text-[10px] font-black rounded-full uppercase tracking-widest">
                                <FluentIcon Value="@(new Size12.Star())" Color="Color.Fill" /> @activeMovie.Rating
                            </span>
                        }
                    </div>

                    @* Wrapped Title (Fixes Typography Overflow) *@
                    <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight hero-animate drop-shadow-2xl line-clamp-2 max-w-full">
                        @activeMovie.Title
                    </h1>

                    <p class="text-xs sm:text-base text-white/70 line-clamp-3 leading-relaxed hero-animate drop-shadow-lg max-w-2xl font-medium">
                        @activeMovie.Summary
                    </p>

                    @* Aligned, balanced premium action buttons *@
                    <div class="flex flex-wrap items-center gap-4 pt-2 hero-animate">
                        <button class="h-12 sm:h-14 px-6 sm:px-8 bg-accent hover:bg-accent-hover text-white text-xs sm:text-sm font-black rounded-2xl shadow-xl shadow-accent/20 flex items-center justify-center gap-2 transition-all duration-300 hover:scale-[1.02] cursor-pointer"
                                @onclick="@(() => NavigateToBooking(activeMovie.Id))">
                            <FluentIcon Value="@(new Size20.Play())" Color="Color.Fill" class="w-5 h-5 flex items-center justify-center" /> 
                            <span>ĐẶT VÉ NGAY</span>
                        </button>
                        <button class="h-12 sm:h-14 px-6 sm:px-8 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-white text-xs sm:text-sm font-black rounded-2xl flex items-center justify-center gap-2 transition-all duration-300 hover:scale-[1.02] cursor-pointer"
                                @onclick="@(() => WatchTrailer(activeMovie.TrailerUrl))">
                            <FluentIcon Value="@(new Size20.Video())" Color="Color.Fill" class="w-5 h-5 flex items-center justify-center" /> 
                            <span>XEM TRAILER</span>
                        </button>
                    </div>
                </div>
            </div>

            @* Slide Navigation Arrows *@
            <button class="absolute left-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-900/60 border border-slate-800 hover:bg-accent hover:border-accent text-white flex items-center justify-center transition-all duration-300 opacity-0 hover:opacity-100 sm:opacity-100 cursor-pointer shadow-lg hover:scale-110 active:scale-95" 
                    @onclick="PrevSlide">
                <FluentIcon Value="@(new Size20.ChevronLeft())" Color="Color.Fill" />
            </button>
            <button class="absolute right-6 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-900/60 border border-slate-800 hover:bg-accent hover:border-accent text-white flex items-center justify-center transition-all duration-300 opacity-0 hover:opacity-100 sm:opacity-100 cursor-pointer shadow-lg hover:scale-110 active:scale-95" 
                    @onclick="NextSlide">
                <FluentIcon Value="@(new Size20.ChevronRight())" Color="Color.Fill" />
            </button>

            @* Slide Indicators (Dots) *@
            <div class="absolute bottom-6 right-6 sm:right-16 z-20 flex gap-2">
                @for (int idx = 0; idx < hotMovies.Count; idx++)
                {
                    var slideIdx = idx;
                    <button class="w-2 h-2 rounded-full transition-all duration-300 cursor-pointer @(slideIdx == _currentSlideIndex ? "bg-accent w-5" : "bg-white/30 hover:bg-white/50")"
                            @onclick="() => ChangeSlide(slideIdx)">
                    </button>
                }
            </div>
        </section>
    }

    @* --- SEARCH RESULTS VIEW OR STANDARD SECTIONS --- *@
    @if (!string.IsNullOrEmpty(Search))
    {
        <section class="container mx-auto">
            <div class="border-b border-slate-200 dark:border-slate-900 pb-4 mb-8">
                <h2 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white uppercase">KẾT QUẢ TÌM KIẾM</h2>
                <div class="h-1.5 w-12 bg-accent mt-2 rounded-full"></div>
            </div>

            @if (nowShowingMovies.Any())
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 sm:gap-8">
                    @foreach (var movie in nowShowingMovies)
                    {
                        <div class="group relative flex flex-col gap-4 transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer"
                             @onclick="@(() => NavigationManager.NavigateTo($"/movies/{movie.Id}"))">
                             
                            <div class="relative aspect-[2/3] overflow-hidden rounded-cinema border border-slate-200 dark:border-slate-900 bg-gradient-to-b from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-950 shadow-lg group-hover:shadow-premium-hover transition-all duration-500">
                                
                                @* Beautiful fallback placeholder if image fails to load or is null *@
                                <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center select-none bg-gradient-to-b from-slate-200 via-slate-100 to-slate-200 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
                                    <div class="w-12 h-12 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mb-3 animate-pulse">
                                        <FluentIcon Value="@(new Size24.MoviesAndTv())" Color="Color.Accent" />
                                    </div>
                                    <span class="text-xs font-black text-slate-800 dark:text-white/80 tracking-wide uppercase line-clamp-2 px-2">@movie.Title</span>
                                    <span class="text-[9px] text-slate-400 dark:text-white/40 font-bold mt-1 uppercase tracking-widest">Không có ảnh</span>
                                </div>

                                @* Dynamic Poster Image *@
                                <img src="@movie.PosterUrl" 
                                     onerror="this.style.opacity='0';"
                                     class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-700 group-hover:scale-105" 
                                     alt="@movie.Title" />
                                     
                                @* Hover Overlay *@
                                <div class="absolute inset-0 z-20 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-4">
                                    <span class="w-full h-10 bg-accent hover:bg-accent-hover text-white text-xs font-black rounded-xl flex items-center justify-center transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">ĐẶT VÉ</span>
                                </div>
                                
                                @* Rating Badge *@
                                @if (movie.Rating.HasValue)
                                {
                                    <div class="absolute top-3 left-3 z-30 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-xl text-[10px] font-black flex items-center gap-1 border border-white/10 shadow-md">
                                        <FluentIcon Value="@(new Size16.Star())" Color="Color.Warning" />
                                        <span>@movie.Rating</span>
                                    </div>
                                }
                            </div>
                            
                            @* Card Title & Meta (Balanced Spacing & Wrapping) *@
                            <div class="px-1 text-left">
                                <h3 class="font-black text-sm sm:text-base leading-snug text-slate-900 dark:text-white line-clamp-2 group-hover:text-accent transition-colors duration-300 h-10 sm:h-12 flex items-center">
                                    @movie.Title
                                </h3>
                                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-bold tracking-wide">
                                    @movie.Year • @string.Join(", ", movie.Genres.Select(g => g.Name))
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="p-20 text-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-850 rounded-[2rem] flex flex-col items-center gap-4 animate-in fade-in duration-300">
                    <p class="text-slate-400 font-bold text-sm">Không có phim đang chiếu nào trùng với từ khóa "@Search".</p>
                    <button class="px-6 py-3 bg-accent text-white font-black text-xs rounded-xl shadow-lg hover:bg-accent-hover transition-colors cursor-pointer" @onclick="@(() => NavigationManager.NavigateTo("/"))">
                        QUAY LẠI TRANG CHỦ
                    </button>
                </div>
            }
        </section>
    }
    else
    {
        @* --- NOW SHOWING SECTION --- *@
        <section class="container mx-auto">
            <div class="flex items-center justify-between mb-8 border-b border-slate-200 dark:border-slate-900 pb-4">
                <div>
                    <h2 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white uppercase">PHIM ĐANG CHIẾU</h2>
                    <div class="h-1.5 w-12 bg-accent mt-2 rounded-full"></div>
                </div>
                <a href="/movies?type=nowshowing" class="text-accent hover:text-accent-hover font-black text-xs sm:text-sm transition-colors duration-300 flex items-center gap-1">Xem tất cả &rarr;</a>
            </div>

            @if (MovieState.Value.IsLoading && !nowShowingMovies.Any())
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 sm:gap-8">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="flex flex-col gap-4 animate-pulse">
                            <div class="aspect-[2/3] bg-slate-200 dark:bg-slate-900 border border-slate-100 dark:border-slate-800 rounded-cinema"></div>
                            <div class="h-6 bg-slate-200 dark:bg-slate-900 border border-slate-150 dark:border-slate-850 rounded w-3/4"></div>
                            <div class="h-4 bg-slate-200 dark:bg-slate-900 border border-slate-150 dark:border-slate-850 rounded w-1/2"></div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 sm:gap-8">
                    @foreach (var movie in nowShowingMovies)
                    {
                        <div class="group relative flex flex-col gap-4 transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer"
                             @onclick="@(() => NavigationManager.NavigateTo($"/movies/{movie.Id}"))">
                             
                            <div class="relative aspect-[2/3] overflow-hidden rounded-cinema border border-slate-200 dark:border-slate-900 bg-gradient-to-b from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-950 shadow-lg group-hover:shadow-premium-hover transition-all duration-500">
                                
                                @* Beautiful fallback placeholder if image fails to load or is null *@
                                <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center select-none bg-gradient-to-b from-slate-200 via-slate-100 to-slate-200 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
                                    <div class="w-12 h-12 rounded-2xl bg-accent/10 border border-accent/20 flex items-center justify-center text-accent mb-3 animate-pulse">
                                        <FluentIcon Value="@(new Size24.MoviesAndTv())" Color="Color.Accent" />
                                    </div>
                                    <span class="text-xs font-black text-slate-800 dark:text-white/80 tracking-wide uppercase line-clamp-2 px-2">@movie.Title</span>
                                    <span class="text-[9px] text-slate-400 dark:text-white/40 font-bold mt-1 uppercase tracking-widest">Không có ảnh</span>
                                </div>

                                @* Dynamic Poster Image *@
                                <img src="@movie.PosterUrl" 
                                     onerror="this.style.opacity='0';"
                                     class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-700 group-hover:scale-105" 
                                     alt="@movie.Title" />
                                     
                                @* Hover Overlay *@
                                <div class="absolute inset-0 z-20 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-4">
                                    <span class="w-full h-10 bg-accent hover:bg-accent-hover text-white text-xs font-black rounded-xl flex items-center justify-center transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">ĐẶT VÉ</span>
                                </div>
                                
                                @* Rating Badge *@
                                @if (movie.Rating.HasValue)
                                {
                                    <div class="absolute top-3 left-3 z-30 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-xl text-[10px] font-black flex items-center gap-1 border border-white/10 shadow-md">
                                        <FluentIcon Value="@(new Size16.Star())" Color="Color.Warning" />
                                        <span>@movie.Rating</span>
                                    </div>
                                }
                            </div>
                            
                            @* Card Title & Meta (Balanced Spacing & Wrapping) *@
                            <div class="px-1 text-left">
                                <h3 class="font-black text-sm sm:text-base leading-snug text-slate-900 dark:text-white line-clamp-2 group-hover:text-accent transition-colors duration-300 h-10 sm:h-12 flex items-center">
                                    @movie.Title
                                </h3>
                                <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-bold tracking-wide">
                                    @movie.Year • @string.Join(", ", movie.Genres.Select(g => g.Name))
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        @* --- COMING SOON SECTION --- *@
        <section class="container mx-auto">
            <div class="flex items-center justify-between mb-8 border-b border-slate-200 dark:border-slate-900 pb-4">
                <div>
                    <h2 class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 dark:text-white uppercase">SẮP KHỞI CHIẾU</h2>
                    <div class="h-1.5 w-12 bg-slate-700 mt-2 rounded-full"></div>
                </div>
                <a href="/movies?type=comingsoon" class="text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white font-black text-xs sm:text-sm transition-colors duration-300 flex items-center gap-1">Xem lịch chiếu &rarr;</a>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 sm:gap-8">
                @foreach (var movie in comingSoonMovies)
                {
                    <div class="group relative flex flex-col gap-4 opacity-95 hover:opacity-100 transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer"
                         @onclick="@(() => NavigationManager.NavigateTo($"/movies/{movie.Id}"))">
                         
                        <div class="relative aspect-[2/3] overflow-hidden rounded-cinema border border-slate-200 dark:border-slate-900 bg-gradient-to-b from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-950 shadow-lg group-hover:shadow-premium-hover transition-all duration-500">
                            
                            @* Fallback placeholder for upcoming movie *@
                            <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center select-none bg-gradient-to-b from-slate-200 via-slate-100 to-slate-200 dark:from-slate-950 dark:via-slate-900 dark:to-slate-950">
                                <div class="w-12 h-12 rounded-2xl bg-slate-200/50 border border-slate-300/50 dark:bg-white/5 dark:border-white/10 flex items-center justify-center text-slate-400 mb-3 animate-pulse">
                                    <FluentIcon Value="@(new Size24.MoviesAndTv())" Color="Color.Neutral" />
                                </div>
                                <span class="text-xs font-black text-slate-800 dark:text-white/80 tracking-wide uppercase line-clamp-2 px-2">@movie.Title</span>
                                <span class="text-[9px] text-slate-400 dark:text-white/40 font-bold mt-1 uppercase tracking-widest">Không có ảnh</span>
                            </div>

                            @* Dynamic Poster Image *@
                            <img src="@movie.PosterUrl" 
                                 onerror="this.style.opacity='0';"
                                 class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-700 group-hover:scale-105" 
                                 alt="@movie.Title" />
                                 
                            @* Elegant Bottom Info Overlay *@
                            <div class="absolute inset-x-0 bottom-0 z-20 p-5 bg-gradient-to-t from-black/95 via-black/60 to-transparent text-white flex flex-col justify-end">
                                <p class="text-[9px] font-black uppercase tracking-widest text-accent mb-1.5">Khởi chiếu @movie.Year</p>
                                <h3 class="font-black text-sm sm:text-base truncate">@movie.Title</h3>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }
</div>

@* --- TRAILER MODAL DIALOG --- *@
@if (!string.IsNullOrEmpty(activeTrailerUrl))
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-black/85 backdrop-blur-md animate-in fade-in duration-300" @onclick="CloseTrailer">
        <div class="relative w-full max-w-4xl aspect-video bg-black rounded-[2rem] overflow-hidden shadow-2xl border border-white/10 mx-4 animate-in zoom-in-95 duration-200" @onclick:stopPropagation>
            <button class="absolute top-4 right-4 z-[110] w-10 h-10 rounded-full bg-black/60 text-white flex items-center justify-center hover:bg-black/80 transition-all border border-white/10 cursor-pointer" 
                    @onclick="CloseTrailer">
                <FluentIcon Value="@(new Size20.Dismiss())" Color="Color.Fill" />
            </button>
            @if (IsYouTubeTrailer(activeTrailerUrl))
            {
                <iframe class="w-full h-full"
                        src="https://www.youtube.com/embed/@(GetYouTubeId(activeTrailerUrl))?autoplay=1&modestbranding=1&rel=0"
                        allow="autoplay; encrypted-media; picture-in-picture"
                        allowfullscreen
                        title="Movie Trailer">
                </iframe>
            }
            else
            {
                <video class="w-full h-full" controls autoplay>
                    <source src="@activeTrailerUrl" type="video/mp4">
                    Trình duyệt của bạn không hỗ trợ phát định dạng video này.
                </video>
            }
        </div>
    </div>
}

@code {
    private System.Timers.Timer? _timer;
    private int _currentSlideIndex = 0;
    private string? activeTrailerUrl;

    [Parameter] [SupplyParameterFromQuery] public string? Genre { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? Search { get; set; }

    // Local cached lists to resolve data from state
    private List<MovieDto> hotMovies = new();
    private List<MovieDto> nowShowingMovies = new();
    private List<MovieDto> comingSoonMovies = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        MovieState.StateChanged += OnMovieStateChanged;
        
        if (MovieState.Value.Movies.Count == 0 && !MovieState.Value.IsLoading)
        {
            Dispatcher.Dispatch(new LoadMoviesAction());
        }
        
        PopulateMovieLists();
    }

    private void OnMovieStateChanged(object? sender, EventArgs e)
    {
        PopulateMovieLists();
        InvokeAsync(StateHasChanged);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        PopulateMovieLists();
    }

    private void PopulateMovieLists()
    {
        var movies = MovieState.Value.Movies;
        
        if (!movies.Any())
        {
            hotMovies.Clear();
            nowShowingMovies.Clear();
            comingSoonMovies.Clear();
            return;
        }

        // Apply Genre Filter
        if (!string.IsNullOrEmpty(Genre))
        {
            movies = movies.Where(m => m.Genres.Any(g => g.Name.Equals(Genre, StringComparison.OrdinalIgnoreCase))).ToList();
        }

        // Apply Search Filter
        if (!string.IsNullOrEmpty(Search))
        {
            movies = movies.Where(m => m.Title.Contains(Search, StringComparison.OrdinalIgnoreCase) || 
                                      m.Summary.Contains(Search, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        // 1. Now Showing Movies
        nowShowingMovies = movies.Where(m => m.MovieType == MovieType.NowShowing).ToList();

        // 2. Coming Soon Movies
        comingSoonMovies = movies.Where(m => m.MovieType == MovieType.ComingSoon).ToList();

        // 3. Hot Movies
        var hot = movies.Where(m => m.Rating >= 8.0m).OrderByDescending(m => m.Rating).Take(5).ToList();
        if (!hot.Any())
        {
            hot = movies.OrderByDescending(m => m.Rating).Take(5).ToList();
        }
        hotMovies = hot;

        // Start Carousel Timer
        if (hotMovies.Any() && _timer == null)
        {
            StartCarouselTimer();
        }
    }

    private void StartCarouselTimer()
    {
        _timer?.Dispose();
        _timer = new System.Timers.Timer(10000); // 10 seconds for real data
        _timer.Elapsed += async (sender, e) =>
        {
            await InvokeAsync(() =>
            {
                NextSlide();
                StateHasChanged();
            });
        };
        _timer.Start();
    }

    private void ResetTimer()
    {
        _timer?.Stop();
        _timer?.Start();
    }

    private async Task ChangeSlide(int newIndex)
    {
        _currentSlideIndex = newIndex;
        ResetTimer();
        
        try
        {
            await JS.InvokeVoidAsync("animateHeroText");
        }
        catch
        {
            // Fallback gracefully if JS/GSAP not loaded yet
        }
    }

    private void NextSlide()
    {
        if (hotMovies.Any())
        {
            _currentSlideIndex = (_currentSlideIndex + 1) % hotMovies.Count;
            ResetTimer();
        }
    }

    private void PrevSlide()
    {
        if (hotMovies.Any())
        {
            _currentSlideIndex = (_currentSlideIndex - 1 + hotMovies.Count) % hotMovies.Count;
            ResetTimer();
        }
    }

    private void WatchTrailer(string url)
    {
        activeTrailerUrl = url;
    }

    private void CloseTrailer()
    {
        activeTrailerUrl = null;
    }

    private void NavigateToBooking(int movieId)
    {
        // 1. Reset state workflow giỏ hàng
        Dispatcher.Dispatch(new WebUI.Shared.Store.Bookings.StartBookingAction(movieId));
        
        // 2. Chuyển sang màn chọn suất chiếu
        NavigationManager.NavigateTo($"/book/showtimes/{movieId}");
    }

    private bool IsYouTubeTrailer(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        return url.Contains("youtube.com", StringComparison.OrdinalIgnoreCase) || url.Contains("youtu.be", StringComparison.OrdinalIgnoreCase);
    }

    private string GetYouTubeId(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";
        var match = System.Text.RegularExpressions.Regex.Match(url, @"(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})");
        return match.Success ? match.Groups[1].Value : "";
    }

    private void ClearFilter(bool isGenre)
    {
        if (isGenre)
        {
            if (!string.IsNullOrEmpty(Search))
            {
                NavigationManager.NavigateTo($"/?search={Uri.EscapeDataString(Search)}");
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
        }
        else
        {
            if (!string.IsNullOrEmpty(Genre))
            {
                NavigationManager.NavigateTo($"/?genre={Uri.EscapeDataString(Genre)}");
            }
            else
            {
                NavigationManager.NavigateTo("/");
            }
        }
    }

    public void Dispose()
    {
        MovieState.StateChanged -= OnMovieStateChanged;
        _timer?.Dispose();
    }
}
