@page "/auth/register"
@using Fluxor
@using WebUI.Shared.Store.Auth
@using Microsoft.FluentUI.AspNetCore.Components
@inject IState<AuthState> AuthState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager

<div class="flex flex-col items-center justify-center min-h-[80vh] px-4">
    <FluentCard class="w-full max-w-md p-8 shadow-lg">
        <EditForm Model="this" OnValidSubmit="HandleRegister" FormName="register-form">
            <div class="flex flex-col gap-6">
                <div class="text-center">
                    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Tạo tài khoản</h1>
                    <p class="text-muted-foreground mt-2">Đăng ký để trải nghiệm đầy đủ các tính năng</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <FluentMessageBar Title="Lỗi đăng ký" Intent="@MessageIntent.Error" AllowDismiss="true">
                        @errorMessage
                    </FluentMessageBar>
                }

                <div class="flex flex-col gap-4">
                    <FluentTextField @bind-Value="username" 
                                     Name="username"
                                     Placeholder="johndoe" 
                                     Label="Tên đăng nhập" 
                                     Required="true" 
                                     class="w-full" />

                    <FluentTextField @bind-Value="email" 
                                     Name="email"
                                     Placeholder="email@example.com" 
                                     Label="Email" 
                                     Required="true" 
                                     class="w-full" />

                    <FluentTextField @bind-Value="password" 
                                     Name="password"
                                     TextFieldType="TextFieldType.Password" 
                                     Label="Mật khẩu" 
                                     Required="true" 
                                     class="w-full" />

                    <FluentTextField @bind-Value="confirmPassword" 
                                     Name="confirmPassword"
                                     TextFieldType="TextFieldType.Password" 
                                     Label="Xác nhận mật khẩu" 
                                     Required="true" 
                                     class="w-full" />
                    
                    <FluentButton Type="ButtonType.Submit"
                                  Appearance="Appearance.Accent" 
                                  class="w-full mt-4" 
                                  Loading="@isLoading">
                        Đăng ký
                    </FluentButton>
                </div>

                <div class="text-center mt-4">
                    <span class="text-sm text-muted-foreground">Đã có tài khoản?</span>
                    <FluentAnchor Appearance="Appearance.Hypertext" Href="/auth/login" class="ml-1">Đăng nhập</FluentAnchor>
                </div>
            </div>
        </EditForm>
    </FluentCard>
</div>

@code {
    [SupplyParameterFromForm]
    private string username { get; set; } = "";
    
    [SupplyParameterFromForm]
    private string email { get; set; } = "";
    
    [SupplyParameterFromForm]
    private string password { get; set; } = "";
    
    [SupplyParameterFromForm]
    private string confirmPassword { get; set; } = "";
    
    private string? errorMessage;
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        if (password != confirmPassword)
        {
            errorMessage = "Mật khẩu xác nhận không khớp.";
            return;
        }

        isLoading = true;
        errorMessage = null;

        // Logic registration...
        isLoading = false;
    }
}
