@page "/about"
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject NavigationManager NavigationManager

<PageTitle>Giới thiệu về chúng tôi | RATE</PageTitle>

<div class="min-h-screen bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-50 via-slate-100 to-slate-200 dark:from-slate-900 dark:via-slate-950 dark:to-black text-slate-900 dark:text-white pt-28 pb-20 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-4xl px-4 flex flex-col gap-16">
        
        @* Hero block - Improved with high clarity cinematic image and white text *@
        <section class="relative h-[350px] sm:h-[400px] rounded-[2.5rem] overflow-hidden shadow-2xl flex items-center justify-center text-center p-8 bg-slate-950 border border-slate-200 dark:border-slate-800/60 group">
            <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=2070&auto=format&fit=crop" 
                 class="absolute inset-0 w-full h-full object-cover opacity-60 dark:opacity-75 transition-transform duration-1000 group-hover:scale-105 select-none" alt="About Hero" />
            <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/40 to-black/80"></div>
            
            <div class="relative z-10 space-y-6 max-w-2xl text-white">
                <h1 class="text-4xl md:text-5xl font-black tracking-tight leading-tight drop-shadow-md">Đồng Hành Cùng Trải Nghiệm Điện Ảnh Của Bạn</h1>
                <p class="text-lg text-white/95 font-medium drop-shadow-sm">
                    RATE tự hào mang tới giải pháp đặt vé xem phim trực tuyến hàng đầu Việt Nam - Kết nối trái tim với những bộ phim bom tấn đỉnh cao.
                </p>
            </div>
        </section>

        @* Our Story & Statistics *@
        <section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight uppercase">Câu Chuyện Của Chúng Tôi</h2>
                <div class="h-1.5 w-20 bg-accent rounded-full"></div>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-semibold">
                    Được thành lập từ năm 2024 với tầm nhìn cách mạng hóa trải nghiệm đặt vé của khán giả điện ảnh, RATE đã không ngừng phát triển, cải tiến công nghệ và mở rộng hệ thống đối tác rạp chiếu lớn trên toàn quốc.
                </p>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed font-semibold">
                    Chúng tôi mang sứ mệnh đưa mọi quy trình từ tìm hiểu phim, đặt lịch chiếu đến việc chọn ghế rạp và thanh toán trở nên vô cùng nhanh chóng chỉ trong vài thao tác chạm nhẹ.
                </p>
            </div>
            
            @* Stats Grid *@
            <div class="grid grid-cols-2 gap-6">
                <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">50+</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Cơ sở rạp chiếu</p>
                </div>
                <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">10M+</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Vé đã được đặt</p>
                </div>
                <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">99.8%</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Giao dịch thành công</p>
                </div>
                <div class="bg-white dark:bg-slate-900 p-8 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">24/7</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Hỗ trợ khách hàng</p>
                </div>
            </div>
        </section>

        @* Core Values *@
        <section class="space-y-10">
            <div class="text-center space-y-3">
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight uppercase">Giá Trị Cốt Lõi</h2>
                <p class="text-slate-400 font-bold">RATE cam kết mang tới chất lượng và sự tin tưởng vững bền</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 dark:bg-amber-950/30 flex items-center justify-center text-amber-600">
                        <FluentIcon Value="@(new Size24.Shield())" />
                    </div>
                    <h4 class="text-lg font-black text-slate-850 dark:text-white">Bảo mật tuyệt đối</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-semibold">RATE tích hợp các cổng thanh toán hàng đầu thế giới với chuẩn bảo mật SSL an toàn nhất hiện nay.</p>
                </div>
                <div class="bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 dark:bg-blue-950/30 flex items-center justify-center text-blue-600">
                        <FluentIcon Value="@(new Size24.MoviesAndTv())" />
                    </div>
                    <h4 class="text-lg font-black text-slate-850 dark:text-white">Trực quan - Tiện lợi</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-semibold">Thiết kế sơ đồ phòng chiếu 3D/IMAX trực quan giúp khách hàng chọn được góc nhìn ưng ý nhất.</p>
                </div>
                <div class="bg-white dark:bg-slate-900 p-8 rounded-[2rem] border border-slate-100 dark:border-slate-800 shadow-sm space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-green-50 dark:bg-green-950/30 flex items-center justify-center text-green-600">
                        <FluentIcon Value="@(new Size24.History())" />
                    </div>
                    <h4 class="text-lg font-black text-slate-850 dark:text-white">Đồng bộ tức thì</h4>
                    <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed font-semibold">Hệ thống xử lý vé theo thời gian thực (Real-time booking) triệt tiêu hoàn toàn khả năng trùng lặp vé ghế.</p>
                </div>
            </div>
        </section>

        @* Call to action - Premium Dark-Themed glow design for ultimate dark mode compatibility *@
        <section class="relative bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 rounded-[2.5rem] border border-slate-800 dark:border-accent/25 p-8 sm:p-12 text-center text-white overflow-hidden shadow-2xl shadow-accent/5 group">
            @* Ambient Glow Effects *@
            <div class="absolute -right-24 -bottom-24 w-72 h-72 bg-accent/20 rounded-full blur-3xl group-hover:bg-accent/30 transition-all duration-700"></div>
            <div class="absolute -left-24 -top-24 w-72 h-72 bg-accent/10 rounded-full blur-3xl"></div>
            <div class="absolute inset-0 bg-radial-gradient(circle_at_center, rgba(229,9,20,0.05) 0%, transparent 70%)"></div>
            
            <div class="relative z-10 space-y-6 max-w-xl mx-auto">
                <h3 class="text-3xl font-black leading-tight drop-shadow-md">Bạn Đã Sẵn Sàng Trải Nghiệm?</h3>
                <p class="text-slate-350 font-medium leading-relaxed">
                    Bắt đầu chọn bộ phim yêu thích của bạn ngay hôm nay và nhận về hàng ngàn ưu đãi hấp dẫn!
                </p>
                <FluentButton Appearance="Appearance.Accent" class="px-8 py-6 h-auto text-base font-black shadow-xl shadow-accent/30 hover:shadow-accent/50 rounded-2xl transition-all duration-300" OnClick="@(() => NavigationManager.NavigateTo("/"))">
                    Khám Phá Phim Ngay
                </FluentButton>
            </div>
        </section>
    </div>
</div>
