@page "/about"
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject NavigationManager NavigationManager

<PageTitle>Giới thiệu về chúng tôi | RATE</PageTitle>

<div class="min-h-screen bg-slate-50 pt-24 pb-20">
    <div class="container mx-auto max-w-4xl px-4 flex flex-col gap-16">
        
        @* Hero block *@
        <section class="relative h-[350px] rounded-3xl overflow-hidden shadow-2xl flex items-center justify-center text-center p-8 bg-slate-900 text-white">
            <img src="https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=2070&auto=format&fit=crop" 
                 class="absolute inset-0 w-full h-full object-cover opacity-30" alt="About Hero" />
            <div class="absolute inset-0 bg-gradient-to-b from-black/50 to-black/85"></div>
            
            <div class="relative z-10 space-y-6 max-w-2xl">
                <h1 class="text-4xl md:text-5xl font-black tracking-tight leading-tight">Đồng Hành Cùng Trải Nghiệm Điện Ảnh Của Bạn</h1>
                <p class="text-lg text-slate-200 font-medium">
                    RATE tự hào mang tới giải pháp đặt vé xem phim trực tuyến hàng đầu Việt Nam - Kết nối trái tim với những bộ phim bom tấn đỉnh cao.
                </p>
            </div>
        </section>

        @* Our Story & Statistics *@
        <section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <h2 class="text-3xl font-black text-slate-900 tracking-tight">Câu Chuyện Của Chúng Tôi</h2>
                <div class="h-1.5 w-20 bg-accent rounded-full"></div>
                <p class="text-slate-600 leading-relaxed font-semibold">
                    Được thành lập từ năm 2024 với tầm nhìn cách mạng hóa trải nghiệm đặt vé của khán giả điện ảnh, RATE đã không ngừng phát triển, cải tiến công nghệ và mở rộng hệ thống đối tác rạp chiếu lớn trên toàn quốc.
                </p>
                <p class="text-slate-600 leading-relaxed font-semibold">
                    Chúng tôi mang sứ mệnh đưa mọi quy trình từ tìm hiểu phim, đặt lịch chiếu đến việc chọn ghế rạp và thanh toán trở nên vô cùng nhanh chóng chỉ trong vài thao tác chạm nhẹ.
                </p>
            </div>
            
            @* Stats Grid *@
            <div class="grid grid-cols-2 gap-6">
                <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">50+</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Cơ sở rạp chiếu</p>
                </div>
                <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">10M+</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Vé đã được đặt</p>
                </div>
                <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">99.8%</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Giao dịch thành công</p>
                </div>
                <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-md text-center space-y-2">
                    <h3 class="text-4xl font-black text-accent">24/7</h3>
                    <p class="text-xs font-black text-slate-400 uppercase tracking-wider">Hỗ trợ khách hàng</p>
                </div>
            </div>
        </section>

        @* Core Values *@
        <section class="space-y-10">
            <div class="text-center space-y-3">
                <h2 class="text-3xl font-black text-slate-900 tracking-tight">Giá Trị Cốt Lõi</h2>
                <p class="text-slate-400 font-bold">RATE cam kết mang tới chất lượng và sự tin tưởng vững bền</p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600">
                        <FluentIcon Value="@(new Size24.Shield())" />
                    </div>
                    <h4 class="text-lg font-black text-slate-850">Bảo mật tuyệt đối</h4>
                    <p class="text-xs text-slate-500 leading-relaxed font-semibold">RATE tích hợp các cổng thanh toán hàng đầu thế giới với chuẩn bảo mật SSL an toàn nhất hiện nay.</p>
                </div>
                <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                        <FluentIcon Value="@(new Size24.MoviesAndTv())" />
                    </div>
                    <h4 class="text-lg font-black text-slate-850">Trực quan - Tiện lợi</h4>
                    <p class="text-xs text-slate-500 leading-relaxed font-semibold">Thiết kế sơ đồ phòng chiếu 3D/IMAX trực quan giúp khách hàng chọn được góc nhìn ưng ý nhất.</p>
                </div>
                <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-sm space-y-4">
                    <div class="w-12 h-12 rounded-2xl bg-green-50 flex items-center justify-center text-green-600">
                        <FluentIcon Value="@(new Size24.History())" />
                    </div>
                    <h4 class="text-lg font-black text-slate-850">Đồng bộ tức thì</h4>
                    <p class="text-xs text-slate-500 leading-relaxed font-semibold">Hệ thống xử lý vé theo thời gian thực (Real-time booking) triệt tiêu hoàn toàn khả năng trùng lặp vé ghế.</p>
                </div>
            </div>
        </section>

        @* Call to action *@
        <section class="bg-slate-900 rounded-[3rem] p-12 text-center text-white space-y-8 relative overflow-hidden shadow-xl">
            <div class="absolute inset-0 bg-gradient-to-r from-accent/20 to-transparent opacity-60"></div>
            <div class="relative z-10 space-y-6 max-w-xl mx-auto">
                <h3 class="text-3xl font-black leading-tight">Bạn Đã Sẵn Sàng Trải Nghiệm?</h3>
                <p class="text-slate-300 font-medium">Bắt đầu chọn bộ phim yêu thích của bạn ngay hôm nay và nhận về hàng ngàn ưu đãi hấp dẫn!</p>
                <FluentButton Appearance="Appearance.Accent" class="px-8 py-6 h-auto text-base font-black shadow-lg shadow-accent/20 rounded-2xl" OnClick="@(() => NavigationManager.NavigateTo("/"))">
                    Khám Phá Phim Ngây
                </FluentButton>
            </div>
        </section>
    </div>
</div>
