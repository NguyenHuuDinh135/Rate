@page "/movies"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using Fluxor
@using WebUI.Shared.Store.Movies
@using WebUI.Shared.Models.Movies
@using WebUI.Shared.Services.Api
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject IState<MovieState> MovieState
@inject IDispatcher Dispatcher
@inject NavigationManager NavigationManager
@inject IGenreApi GenreApi

<PageTitle>Danh sách phim | RATE</PageTitle>

<div class="flex flex-col gap-8 pb-16">
    @* Header and Tab Selector *@
    <div class="border-b border-slate-200 dark:border-slate-900 pb-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-slate-900 dark:text-white">
                @(SelectedType == MovieType.ComingSoon ? "Phim sắp khởi chiếu" : "Phim đang chiếu")
            </h1>
            <div class="h-1.5 w-12 bg-accent mt-2 rounded-full"></div>
        </div>
        
        @* Beautiful premium tabs *@
        <div class="flex bg-slate-100 dark:bg-slate-900 p-1 rounded-2xl border border-slate-200/50 dark:border-slate-800/80 w-fit">
            <button class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all duration-300 @(SelectedType == MovieType.NowShowing ? "bg-accent text-white shadow-lg shadow-accent/20" : "text-slate-500 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white bg-transparent border-none cursor-pointer")"
                    @onclick="() => SetMovieType(MovieType.NowShowing)">
                Đang chiếu
            </button>
            <button class="px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all duration-300 @(SelectedType == MovieType.ComingSoon ? "bg-accent text-white shadow-lg shadow-accent/20" : "text-slate-500 hover:text-slate-950 dark:text-slate-400 dark:hover:text-white bg-transparent border-none cursor-pointer")"
                    @onclick="() => SetMovieType(MovieType.ComingSoon)">
                Sắp khởi chiếu
            </button>
        </div>
    </div>

    @* Genre Filters Row *@
    @if (genres.Any())
    {
        <div class="flex flex-wrap items-center gap-2 pb-6 border-b border-slate-250/20 dark:border-slate-900">
            <button class="px-4 py-2 rounded-xl text-xs font-black uppercase tracking-widest transition-all duration-300 @(string.IsNullOrEmpty(Genre) ? "bg-accent text-white shadow-md shadow-accent/15" : "bg-slate-100 hover:bg-slate-200 text-slate-650 dark:bg-slate-900 dark:hover:bg-slate-800 dark:text-slate-400 border border-transparent cursor-pointer")"
                    @onclick="() => FilterByGenre(null)">
                Tất cả thể loại
            </button>
            @foreach (var g in genres)
            {
                var isSelected = g.Name.Equals(Genre, StringComparison.OrdinalIgnoreCase);
                <button class="px-4 py-2 rounded-xl text-xs font-black uppercase tracking-widest transition-all duration-300 @(isSelected ? "bg-accent text-white shadow-md shadow-accent/15" : "bg-slate-100 hover:bg-slate-200 text-slate-650 dark:bg-slate-900 dark:hover:bg-slate-800 dark:text-slate-400 border border-transparent cursor-pointer")"
                        @onclick="() => FilterByGenre(g.Name)">
                    @g.Name
                </button>
            }
        </div>
    }

    @* Movie Grid *@
    @if (MovieState.Value.IsLoading)
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 sm:gap-8 animate-pulse">
            @for (int i = 0; i < 6; i++)
            {
                <div class="flex flex-col gap-4">
                    <div class="aspect-[2/3] bg-slate-200 dark:bg-slate-900 rounded-cinema"></div>
                    <div class="h-6 bg-slate-200 dark:bg-slate-900 rounded w-3/4"></div>
                    <div class="h-4 bg-slate-200 dark:bg-slate-900 rounded w-1/2"></div>
                </div>
            }
        </div>
    }
    else if (filteredMovies.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 sm:gap-8">
            @foreach (var movie in filteredMovies)
            {
                <div class="group relative flex flex-col gap-4 transition-all duration-300 transform hover:-translate-y-1.5 cursor-pointer"
                     @onclick="@(() => NavigationManager.NavigateTo($"/movies/{movie.Id}"))">
                     
                    <div class="relative aspect-[2/3] overflow-hidden rounded-cinema border border-slate-200 dark:border-slate-900 bg-gradient-to-b from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-950 shadow-lg group-hover:shadow-premium-hover transition-all duration-500">
                        <img src="@movie.PosterUrl" 
                             onerror="this.style.opacity='0';"
                             class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-700 group-hover:scale-105" 
                             alt="@movie.Title" />
                        
                        @* Hover Overlay *@
                        <div class="absolute inset-0 z-20 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-4">
                            <span class="w-full h-10 bg-accent hover:bg-accent-hover text-white text-xs font-black rounded-xl flex items-center justify-center transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                                @(SelectedType == MovieType.NowShowing ? "ĐẶT VÉ" : "XEM CHI TIẾT")
                            </span>
                        </div>
                        
                        @if (movie.Rating.HasValue && SelectedType == MovieType.NowShowing)
                        {
                            <div class="absolute top-3 left-3 z-30 bg-black/60 backdrop-blur-md text-white px-2.5 py-1 rounded-xl text-[10px] font-black flex items-center gap-1 border border-white/10 shadow-md">
                                <FluentIcon Value="@(new Size16.Star())" Color="Color.Warning" />
                                <span>@movie.Rating</span>
                            </div>
                        }
                    </div>
                    
                    <div class="px-1 text-left">
                        <h3 class="font-black text-sm sm:text-base leading-snug text-slate-900 dark:text-white line-clamp-2 group-hover:text-accent transition-colors duration-300 h-10 sm:h-12 flex items-center">
                            @movie.Title
                        </h3>
                        <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 font-bold tracking-wide">
                            @movie.Year • @string.Join(", ", movie.Genres.Select(g => g.Name))
                        </p>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="p-20 text-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-850 rounded-[2rem] flex flex-col items-center gap-4">
            <p class="text-slate-400 font-bold">Không tìm thấy bộ phim nào thuộc thể loại này.</p>
            <button class="px-6 py-3 bg-accent text-white font-black text-xs rounded-xl shadow-lg hover:bg-accent-hover transition-colors cursor-pointer"
                    @onclick="() => FilterByGenre(null)">
                Xem tất cả phim
            </button>
        </div>
    }
</div>

@code {
    [Parameter] [SupplyParameterFromQuery] public string? Type { get; set; }
    [Parameter] [SupplyParameterFromQuery] public string? Genre { get; set; }

    private MovieType SelectedType => Type?.ToLower() == "comingsoon" ? MovieType.ComingSoon : MovieType.NowShowing;
    private List<GenreDto> genres = new();

    private List<MovieDto> filteredMovies => MovieState.Value.Movies
        .Where(m => m.MovieType == SelectedType)
        .Where(m => string.IsNullOrEmpty(Genre) || m.Genres.Any(g => g.Name.Equals(Genre, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        if (MovieState.Value.Movies.Count == 0 && !MovieState.Value.IsLoading)
        {
            Dispatcher.Dispatch(new LoadMoviesAction());
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            var response = await GenreApi.GetAllAsync();
            genres = response.Body ?? new();
        }
        catch
        {
            // Fallback genres if API is slow or offline
            genres = new List<GenreDto>
            {
                new() { Id = 1, Name = "Hành động" },
                new() { Id = 2, Name = "Viễn tưởng" },
                new() { Id = 3, Name = "Kinh dị" },
                new() { Id = 4, Name = "Hài hước" },
                new() { Id = 5, Name = "Tâm lý" }
            };
        }
    }

    private void SetMovieType(MovieType movieType)
    {
        var typeStr = movieType == MovieType.ComingSoon ? "comingsoon" : "nowshowing";
        if (string.IsNullOrEmpty(Genre))
        {
            NavigationManager.NavigateTo($"/movies?type={typeStr}");
        }
        else
        {
            NavigationManager.NavigateTo($"/movies?type={typeStr}&genre={Uri.EscapeDataString(Genre)}");
        }
    }

    private void FilterByGenre(string? genreName)
    {
        var typeStr = SelectedType == MovieType.ComingSoon ? "comingsoon" : "nowshowing";
        if (string.IsNullOrEmpty(genreName))
        {
            NavigationManager.NavigateTo($"/movies?type={typeStr}");
        }
        else
        {
            NavigationManager.NavigateTo($"/movies?type={typeStr}&genre={Uri.EscapeDataString(genreName)}");
        }
    }
}
