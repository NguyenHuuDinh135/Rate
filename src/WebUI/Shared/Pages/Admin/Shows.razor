@page "/admin/shows"
@page "/admin/showtimes"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.UI
@inject IShowApi ShowApi
@inject IMovieApi MovieApi
@inject ITheaterApi TheaterApi
@inject MudBlazor.ISnackbar Snackbar

<PageTitle>Suất chiếu | RATE Admin</PageTitle>

<PageHeader Title="Suất chiếu"
            Description="Sắp lịch chiếu theo phim, phòng chiếu, ngày và khung giờ.">
    <Actions>
        <PrimaryButton Icon="@MudBlazor.Icons.Material.Outlined.Add" OnClick="@CreateShow">Thêm suất chiếu</PrimaryButton>
    </Actions>
</PageHeader>

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_shows.Any())"
           OnRetry="@LoadShows">
    <DataCard>
        <div class="rate-toolbar">
            <SearchBox @bind-Value="_searchText" Placeholder="Tìm phim, rạp, trạng thái..." />
            <div class="rate-toolbar__right">
                <Badge Tone="primary">@FilteredShows.Count() suất</Badge>
            </div>
        </div>

        <DataTable TItem="ShowDto" Items="@PagedShows" EmptyMessage="Không tìm thấy suất chiếu phù hợp.">
            <HeaderContent>
                <MudTh>Phim</MudTh>
                <MudTh>Rạp</MudTh>
                <MudTh>Ngày</MudTh>
                <MudTh>Thời gian</MudTh>
                <MudTh>Loại</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="show">
                <MudTd DataLabel="Phim"><strong>@MovieTitle(show.MovieId)</strong></MudTd>
                <MudTd DataLabel="Rạp">@TheaterName(show.TheaterId)</MudTd>
                <MudTd DataLabel="Ngày">@FormatDate(show.Date)</MudTd>
                <MudTd DataLabel="Thời gian">@show.StartTime - @show.EndTime</MudTd>
                <MudTd DataLabel="Loại"><Badge Tone="info">@ShowTypeLabel(show.Type)</Badge></MudTd>
                <MudTd DataLabel="Trạng thái"><Badge Tone="@ShowStatusTone(show.Status)">@DisplayText(show.Status)</Badge></MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Chỉnh sửa" Intent="primary" OnClick="@(() => EditShow(show))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa" Intent="danger" OnClick="@(() => DeleteShow(show))" />
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredShows.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<ShowDto> _shows = [];
    private readonly Dictionary<int, string> _movieNames = [];
    private readonly Dictionary<int, string> _theaterNames = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<ShowDto> FilteredShows => _shows
        .Where(show =>
            string.IsNullOrWhiteSpace(_searchText)
            || MovieTitle(show.MovieId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || TheaterName(show.TheaterId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || DisplayText(show.Status).Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ShowDto> PagedShows => FilteredShows
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadShows();
    }

    private async Task LoadShows()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _shows.Clear();
            _movieNames.Clear();
            _theaterNames.Clear();

            _shows.AddRange(await ShowApi.GetAllAsync() ?? []);

            foreach (var movie in await MovieApi.GetAllAsync() ?? [])
            {
                _movieNames[movie.Id] = movie.Title;
            }

            foreach (var theater in await TheaterApi.GetAllAsync() ?? [])
            {
                _theaterNames[theater.Id] = theater.Name;
            }
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private void CreateShow() => Snackbar.Add("API tạo suất chiếu chưa sẵn sàng.", MudBlazor.Severity.Info);
    private void EditShow(ShowDto show) => Snackbar.Add($"API cập nhật suất chiếu #{show.Id} chưa sẵn sàng.", MudBlazor.Severity.Info);
    private void DeleteShow(ShowDto show) => Snackbar.Add($"API xóa suất chiếu #{show.Id} chưa sẵn sàng.", MudBlazor.Severity.Warning);

    private string MovieTitle(int movieId) => _movieNames.TryGetValue(movieId, out var title) ? title : $"Phim #{movieId}";
    private string TheaterName(int theaterId) => _theaterNames.TryGetValue(theaterId, out var name) ? name : $"Rạp #{theaterId}";
    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "Không rõ" : value;
    private static string ShowTypeLabel(ShowType type) => type == ShowType.ThreeD ? "3D" : "2D";

    private static string FormatDate(string value)
    {
        return DateTime.TryParse(value, out var date) ? date.ToString("dd/MM/yyyy") : value;
    }

    private static string ShowStatusTone(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return "neutral";
        }

        return status.ToLowerInvariant() switch
        {
            "active" or "available" or "open" => "success",
            "cancelled" or "canceled" => "danger",
            "soldout" or "sold_out" => "warning",
            _ => "primary"
        };
    }
}
