@page "/admin/shows"
@page "/admin/showtimes"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.Admin.Dialogs
@using WebUI.Shared.Components.UI
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Models.Theaters
@using WebUI.Shared.Models.Common
@inject IShowApi ShowApi
@inject IMovieApi MovieApi
@inject ITheaterApi TheaterApi
@inject MudBlazor.ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Suất chiếu | RATE Admin</PageTitle>

<PageHeader Title="Suất chiếu"
            Description="Sắp lịch chiếu theo phim, phòng chiếu, ngày và khung giờ.">
    <Actions>
        <PrimaryButton Icon="@MudBlazor.Icons.Material.Outlined.Add" OnClick="@CreateShow">Thêm suất chiếu</PrimaryButton>
    </Actions>
</PageHeader>

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_shows.Any())"
           OnRetry="@LoadShows">
    <DataCard>
        <div class="rate-toolbar">
            <SearchBox @bind-Value="_searchText" Placeholder="Tìm phim, rạp, trạng thái..." />
            <div class="rate-toolbar__right">
                <Badge Tone="primary">@FilteredShows.Count() suất</Badge>
            </div>
        </div>

        <DataTable TItem="ShowDto" Items="@PagedShows" EmptyMessage="Không tìm thấy suất chiếu phù hợp.">
            <HeaderContent>
                <MudTh>Phim</MudTh>
                <MudTh>Rạp</MudTh>
                <MudTh>Ngày</MudTh>
                <MudTh>Thời gian</MudTh>
                <MudTh>Loại</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="show">
                <MudTd DataLabel="Phim"><strong>@MovieTitle(show.MovieId)</strong></MudTd>
                <MudTd DataLabel="Rạp">@TheaterName(show.TheaterId)</MudTd>
                <MudTd DataLabel="Ngày">@FormatDate(show.Date)</MudTd>
                <MudTd DataLabel="Thời gian">@show.StartTime - @show.EndTime</MudTd>
                <MudTd DataLabel="Loại"><Badge Tone="info">@ShowTypeLabel(show.Type)</Badge></MudTd>
                <MudTd DataLabel="Trạng thái"><Badge Tone="@ShowStatusTone(show.Status)">@ShowStatusLabel(show.Status)</Badge></MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Chỉnh sửa" Intent="primary" OnClick="@(() => EditShow(show))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa" Intent="danger" OnClick="@(() => DeleteShow(show))" />
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredShows.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<ShowDto> _shows = [];
    private readonly Dictionary<int, string> _movieNames = [];
    private readonly Dictionary<int, string> _theaterNames = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<ShowDto> FilteredShows => _shows
        .Where(show =>
            string.IsNullOrWhiteSpace(_searchText)
            || MovieTitle(show.MovieId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || TheaterName(show.TheaterId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || ShowStatusLabel(show.Status).Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ShowDto> PagedShows => FilteredShows
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadShows();
    }

    private async Task LoadShows()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _shows.Clear();
            _movieNames.Clear();
            _theaterNames.Clear();

            _shows.AddRange(await ShowApi.GetAllAsync() ?? []);

            foreach (var movie in await MovieApi.GetAllAsync() ?? [])
            {
                _movieNames[movie.Id] = movie.Title;
            }

            foreach (var theater in await TheaterApi.GetAllAsync() ?? [])
            {
                _theaterNames[theater.Id] = theater.Name;
            }
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private async Task CreateShow()
    {
        if (_movieNames.Count == 0 || _theaterNames.Count == 0)
        {
            Snackbar.Add("Cần có phim và rạp trước khi tạo suất chiếu.", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { "Movies", _movieNames },
            { "Theaters", _theaterNames }
        };

        var dialog = await DialogService.ShowAsync<ShowDialog>(
            "Thêm suất chiếu mới", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is ShowDialog.ShowFormModel model)
        {
            try
            {
                var response = await ShowApi.CreateAsync(new CreateShowCommand(
                    model.Date!.Value,
                    model.StartTime!.Value,
                    model.EndTime!.Value,
                    model.MovieId,
                    model.TheaterId,
                    (int)model.Type));
                
                Snackbar.Add(response.Succeeded ? "Đã tạo suất chiếu mới." : "Không thể tạo suất chiếu lúc này.", response.Succeeded ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                await LoadShows();
            }
            catch
            {
                Snackbar.Add("Không thể tạo suất chiếu lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task EditShow(ShowDto show)
    {
        var parameters = new DialogParameters
        {
            { "Show", show },
            { "Movies", _movieNames },
            { "Theaters", _theaterNames }
        };

        var dialog = await DialogService.ShowAsync<ShowDialog>(
            "Chỉnh sửa suất chiếu", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is ShowDialog.ShowFormModel model)
        {
            try
            {
                await ShowApi.UpdateAsync(new UpdateShowCommand(
                    show.Id,
                    model.Date!.Value,
                    model.StartTime!.Value,
                    model.EndTime!.Value,
                    model.MovieId,
                    model.TheaterId,
                    (int)model.Type,
                    (int)model.Status));
                
                Snackbar.Add("Đã đồng bộ suất chiếu.", MudBlazor.Severity.Success);
                await LoadShows();
            }
            catch
            {
                Snackbar.Add("Không thể cập nhật suất chiếu lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task DeleteShow(ShowDto show)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Bạn có chắc chắn muốn xóa suất chiếu #{show.Id} không?" },
            { "ButtonText", "Xóa suất chiếu" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            "Xác nhận xóa", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                await ShowApi.DeleteAsync(show.Id);
                Snackbar.Add("Đã xóa suất chiếu.", MudBlazor.Severity.Success);
                await LoadShows();
            }
            catch
            {
                Snackbar.Add("Không thể xóa suất chiếu lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private string MovieTitle(int movieId) => _movieNames.TryGetValue(movieId, out var title) ? title : $"Phim #{movieId}";
    private string TheaterName(int theaterId) => _theaterNames.TryGetValue(theaterId, out var name) ? name : $"Rạp #{theaterId}";
    private static string ShowTypeLabel(ShowType type) => type switch
    {
        ShowType.TwoD => "2D",
        ShowType.ThreeD => "3D",
        _ => "Không rõ"
    };

    private static string FormatDate(string value)
    {
        return DateTime.TryParse(value, out var date) ? date.ToString("dd/MM/yyyy") : value;
    }

    private static string DateInputValue(string value)
        => DateTime.TryParse(value, out var date) ? date.ToString("yyyy-MM-dd") : value;

    private static string ShowStatusLabel(ShowStatus status) => status switch
    {
        ShowStatus.Free => "Còn ghế",
        ShowStatus.AlmostFull => "Sắp đầy",
        ShowStatus.Full => "Đã đầy",
        _ => "Không rõ"
    };

    private static string ShowStatusTone(ShowStatus status)
    {
        return status switch
        {
            ShowStatus.Free => "success",
            ShowStatus.AlmostFull => "warning",
            ShowStatus.Full => "danger",
            _ => "neutral"
        };
    }
}
