@page "/admin/shows"
@layout AdminLayout
@using WebUI.Shared.Models.Theaters
@using WebUI.Shared.Services.Api
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject IShowApi ShowApi
@inject IMovieApi MovieApi
@inject ITheaterApi TheaterApi
@inject IToastService ToastService

<div class="flex flex-col gap-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900">Quản lý suất chiếu</h1>
            <p class="text-slate-500 font-medium">Xếp lịch chiếu phim cho các rạp hát</p>
        </div>
        <FluentButton Appearance="Appearance.Accent" IconStart="@(new Size20.Add())" class="h-12 px-6 font-bold shadow-lg shadow-accent/20 rounded-xl">Thêm suất chiếu</FluentButton>
    </div>

    @if (isLoading)
    {
        <div class="h-64 flex items-center justify-center bg-white rounded-[2rem] shadow-sm"><FluentProgressRing /></div>
    }
    else
    {
        <FluentCard class="p-0 overflow-hidden border-none shadow-md rounded-[2rem] bg-white">
            <FluentDataGrid Items="@shows.AsQueryable()" TGridItem="ShowDto" Pagination="@pagination">
                <PropertyColumn Property="@(s => s.Id)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(s => s.MovieId)" Title="Mã Phim" Sortable="true" />
                <PropertyColumn Property="@(s => s.TheaterId)" Title="Mã Rạp" Sortable="true" />
                <PropertyColumn Property="@(s => DateTime.Parse(s.Date).ToShortDateString())" Title="Ngày" Sortable="true" />
                <PropertyColumn Property="@(s => s.StartTime)" Title="Bắt đầu" Sortable="true" />
                <PropertyColumn Property="@(s => s.EndTime)" Title="Kết thúc" Sortable="true" />
                
                <TemplateColumn Title="Loại" Sortable="true">
                    <FluentBadge Appearance="Appearance.Lightweight" Color="@(context.Type == WebUI.Shared.Models.Common.ShowType.ThreeD ? "accent" : "neutral")">
                        @context.Type
                    </FluentBadge>
                </TemplateColumn>

                <TemplateColumn Title="Hành động" Align="Align.End">
                    <div class="flex gap-2 justify-end">
                        <FluentButton IconStart="@(new Size20.Edit())" Appearance="Appearance.Stealth" />
                        <FluentButton IconStart="@(new Size20.Delete())" Appearance="Appearance.Stealth" Color="Color.Error" />
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
            
            <div class="p-4 border-t bg-slate-50 flex justify-center">
                <FluentPaginator State="@pagination" />
            </div>
        </FluentCard>
    }
</div>

@code {
    private List<ShowDto> shows = new();
    private bool isLoading = true;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            shows = await ShowApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi tải suất chiếu: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
