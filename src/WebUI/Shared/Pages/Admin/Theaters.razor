@page "/admin/theaters"
@page "/admin/cinemas"
@page "/admin/rooms"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.Admin.Dialogs
@using WebUI.Shared.Components.UI
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Models.Theaters
@inject ITheaterApi TheaterApi
@inject MudBlazor.ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Rạp chiếu | RATE Admin</PageTitle>

<PageHeader Title="Rạp chiếu"
            Description="Quản lý phòng chiếu, kiểu phòng và sức chứa ghế. Room được ánh xạ theo Theater hiện có.">
    <Actions>
        <PrimaryButton Icon="@MudBlazor.Icons.Material.Outlined.Add" OnClick="@CreateTheater">Thêm rạp</PrimaryButton>
    </Actions>
</PageHeader>

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_theaters.Any())"
           OnRetry="@LoadTheaters">
    <DataCard>
        <div class="rate-toolbar">
            <SearchBox @bind-Value="_searchText" Placeholder="Tìm theo tên rạp/phòng..." />
            <Badge Tone="primary">@FilteredTheaters.Count() phòng</Badge>
        </div>

        <DataTable TItem="TheaterDto" Items="@PagedTheaters" EmptyMessage="Không tìm thấy rạp chiếu phù hợp.">
            <HeaderContent>
                <MudTh>Rạp/Phòng</MudTh>
                <MudTh>Loại</MudTh>
                <MudTh>Sơ đồ</MudTh>
                <MudTh>Số ghế</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="theater">
                <MudTd DataLabel="Rạp/Phòng">
                    <strong>@theater.Name</strong>
                    <div class="text-xs text-slate-500">#@theater.Id</div>
                </MudTd>
                <MudTd DataLabel="Loại"><Badge Tone="info">@theater.Type</Badge></MudTd>
                <MudTd DataLabel="Sơ đồ">@theater.NumOfRows hàng × @theater.SeatsPerRow ghế</MudTd>
                <MudTd DataLabel="Số ghế">@SeatCount(theater).ToString("N0")</MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Visibility" Title="Xem sơ đồ" OnClick="@(() => ViewTheater(theater))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Chỉnh sửa" Intent="primary" OnClick="@(() => EditTheater(theater))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa" Intent="danger" OnClick="@(() => DeleteTheater(theater))" />
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredTheaters.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<TheaterDto> _theaters = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<TheaterDto> FilteredTheaters => _theaters
        .Where(theater => string.IsNullOrWhiteSpace(_searchText)
            || theater.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || theater.Type.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TheaterDto> PagedTheaters => FilteredTheaters
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadTheaters();
    }

    private async Task LoadTheaters()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _theaters.Clear();
            var response = await TheaterApi.GetAllAsync();
            _theaters.AddRange(response?.Body ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private async Task CreateTheater()
    {
        var dialog = await DialogService.ShowAsync<TheaterDialog>(
            "Thêm rạp chiếu mới", 
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is TheaterDialog.TheaterFormModel model)
        {
            try
            {
                var response = await TheaterApi.CreateAsync(new CreateTheaterCommand(model.Name.Trim(), model.NumOfRows, model.SeatsPerRow, (int)model.Type));
                Snackbar.Add(response.Succeeded ? "Đã tạo rạp mới." : "Không thể tạo rạp lúc này.", response.Succeeded ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                await LoadTheaters();
            }
            catch
            {
                Snackbar.Add("Không thể tạo rạp lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private void ViewTheater(TheaterDto theater) => Snackbar.Add($"Đang xem sơ đồ {theater.Name}.", MudBlazor.Severity.Info);

    private async Task EditTheater(TheaterDto theater)
    {
        var parameters = new DialogParameters
        {
            { "Theater", theater }
        };

        var dialog = await DialogService.ShowAsync<TheaterDialog>(
            "Chỉnh sửa rạp chiếu", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is TheaterDialog.TheaterFormModel model)
        {
            try
            {
                await TheaterApi.UpdateAsync(new UpdateTheaterCommand(theater.Id, model.Name.Trim(), model.NumOfRows, model.SeatsPerRow, (int)model.Type));
                Snackbar.Add("Đã cập nhật thông tin rạp.", MudBlazor.Severity.Success);
                await LoadTheaters();
            }
            catch
            {
                Snackbar.Add("Không thể cập nhật rạp lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task DeleteTheater(TheaterDto theater)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Bạn có chắc chắn muốn xóa rạp/phòng '{theater.Name}' không?" },
            { "ButtonText", "Xóa rạp" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            "Xác nhận xóa", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                await TheaterApi.DeleteAsync(theater.Id);
                Snackbar.Add("Đã xóa rạp.", MudBlazor.Severity.Success);
                await LoadTheaters();
            }
            catch
            {
                Snackbar.Add("Không thể xóa rạp lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private static int SeatCount(TheaterDto theater) => Math.Max(0, (theater.NumOfRows * theater.SeatsPerRow) - (theater.Missing?.Count ?? 0) - (theater.Blocked?.Count ?? 0));
}
