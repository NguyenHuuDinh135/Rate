@page "/admin/theaters"
@layout AdminLayout
@using WebUI.Shared.Models.Theaters
@using WebUI.Shared.Services.Api
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject ITheaterApi TheaterApi
@inject IToastService ToastService

<div class="flex flex-col gap-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900">Quản lý rạp hát</h1>
            <p class="text-slate-500 font-medium">Cấu hình phòng chiếu và sơ đồ ghế</p>
        </div>
        <FluentButton Appearance="Appearance.Accent" IconStart="@(new Size20.Add())" class="h-12 px-6 font-bold shadow-lg shadow-accent/20 rounded-xl">Thêm rạp mới</FluentButton>
    </div>

    @if (isLoading)
    {
        <div class="h-64 flex items-center justify-center bg-white rounded-[2rem] shadow-sm"><FluentProgressRing /></div>
    }
    else
    {
        <FluentCard class="p-0 overflow-hidden border-none shadow-md rounded-[2rem] bg-white">
            <FluentDataGrid Items="@theaters.AsQueryable()" TGridItem="TheaterDto" Pagination="@pagination">
                <PropertyColumn Property="@(t => t.Id)" Title="ID" Sortable="true" />
                <PropertyColumn Property="@(t => t.Name)" Title="Tên Rạp" Sortable="true" Filterable="true" />
                <PropertyColumn Property="@(t => t.NumOfRows)" Title="Số hàng" Sortable="true" />
                <PropertyColumn Property="@(t => t.SeatsPerRow)" Title="Ghế mỗi hàng" Sortable="true" />
                <PropertyColumn Property="@(t => t.Type)" Title="Loại" Sortable="true" />
                
                <TemplateColumn Title="Tổng số ghế">
                    @(context.NumOfRows * context.SeatsPerRow)
                </TemplateColumn>

                <TemplateColumn Title="Hành động" Align="Align.End">
                    <div class="flex gap-2 justify-end">
                        <FluentButton IconStart="@(new Size20.Settings())" Appearance="Appearance.Stealth" Title="Cấu hình ghế" />
                        <FluentButton IconStart="@(new Size20.Edit())" Appearance="Appearance.Stealth" />
                        <FluentButton IconStart="@(new Size20.Delete())" Appearance="Appearance.Stealth" Color="Color.Error" />
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
            
            <div class="p-4 border-t bg-slate-50 flex justify-center">
                <FluentPaginator State="@pagination" />
            </div>
        </FluentCard>
    }
</div>

@code {
    private List<TheaterDto> theaters = new();
    private bool isLoading = true;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            theaters = await TheaterApi.GetAllAsync();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi tải danh sách rạp: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
