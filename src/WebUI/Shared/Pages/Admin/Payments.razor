@page "/admin/payments"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.Admin.Dialogs
@using WebUI.Shared.Components.UI
@inject IPaymentApi PaymentApi
@inject MudBlazor.ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Thanh toán | RATE Admin</PageTitle>

<PageHeader Title="Thanh toán"
            Description="Giám sát giao dịch, phương thức thanh toán và doanh thu vé.">
    <Actions>
        <DataCard Class="px-4 py-2">
            <span class="text-xs text-slate-500 font-bold uppercase">Tổng doanh thu</span>
            <strong class="block text-lg text-red-600">@FormatCurrency(_payments.Sum(p => p.Amount))</strong>
        </DataCard>
    </Actions>
</PageHeader>

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_payments.Any())"
           OnRetry="@LoadPayments">
    <DataCard>
        <div class="rate-toolbar">
            <div class="rate-toolbar__left">
                <SearchBox @bind-Value="_searchText" Placeholder="Tìm mã hóa đơn, khách hàng, phim..." />
                <MudSelect T="string" @bind-Value="_methodFilter" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Dense="true" Class="min-w-40">
                    <MudSelectItem T="string" Value="@("all")">Tất cả phương thức</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Cash")">Cash</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Card")">Card</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Momo")">Momo</MudSelectItem>
                    <MudSelectItem T="string" Value="@("VnPay")">VnPay</MudSelectItem>
                </MudSelect>
            </div>
            <Badge Tone="primary">@FilteredPayments.Count() giao dịch</Badge>
        </div>

        <DataTable TItem="PaymentDto" Items="@PagedPayments" EmptyMessage="Không tìm thấy giao dịch phù hợp.">
            <HeaderContent>
                <MudTh>Mã hóa đơn</MudTh>
                <MudTh>Khách hàng</MudTh>
                <MudTh>Phim</MudTh>
                <MudTh>Số tiền</MudTh>
                <MudTh>Phương thức</MudTh>
                <MudTh>Thời gian</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="payment">
                <MudTd DataLabel="Mã hóa đơn">#@payment.PaymentId</MudTd>
                <MudTd DataLabel="Khách hàng">@DisplayText(payment.UserId)</MudTd>
                <MudTd DataLabel="Phim">@DisplayText(payment.Movie?.Title)</MudTd>
                <MudTd DataLabel="Số tiền"><strong>@FormatCurrency(payment.Amount)</strong></MudTd>
                <MudTd DataLabel="Phương thức"><Badge Tone="info">@payment.PaymentMethod</Badge></MudTd>
                <MudTd DataLabel="Thời gian">@FormatDateTime(payment.PaymentDatetime)</MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Visibility" Title="Xem giao dịch" OnClick="@(() => ViewPayment(payment))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Hoàn/hủy" Intent="danger" OnClick="@(() => DeletePayment(payment))" />
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredPayments.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<PaymentDto> _payments = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private string _methodFilter = "all";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<PaymentDto> FilteredPayments => _payments
        .Where(payment => string.IsNullOrWhiteSpace(_searchText)
            || payment.PaymentId.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || DisplayText(payment.UserId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || DisplayText(payment.Movie?.Title).Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(payment => _methodFilter == "all"
            || string.Equals(payment.PaymentMethod, _methodFilter, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PaymentDto> PagedPayments => FilteredPayments
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _payments.Clear();
            var response = await PaymentApi.GetAllAsync();
            _payments.AddRange(response?.Body ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private void ViewPayment(PaymentDto payment)
    {
        Snackbar.Add($"Đang xem hóa đơn #{payment.PaymentId}.", MudBlazor.Severity.Info);
    }

    private async Task DeletePayment(PaymentDto payment)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Hoàn/hủy hóa đơn #{payment.PaymentId}?" },
            { "ButtonText", "Hủy hóa đơn" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            "Xác nhận xử lý", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                // Assuming we want to keep the same amount but maybe change status if backend supported it. 
                // Currently UpdatePaymentCommand only takes Amount and PaymentMethod.
                // Let's just pass them as they are.
                await PaymentApi.DeleteAsync(payment.PaymentId);
                Snackbar.Add("Đã xử lý giao dịch.", MudBlazor.Severity.Success);
                await LoadPayments();
            }
            catch
            {
                Snackbar.Add("Không thể xử lý giao dịch lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatCurrency(decimal amount) => $"{amount:N0} đ";

    private static string FormatDateTime(string value)
    {
        return DateTime.TryParse(value, out var date) ? date.ToString("HH:mm, dd/MM/yyyy") : value;
    }
}
