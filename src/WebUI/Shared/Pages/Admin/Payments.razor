@page "/admin/payments"
@layout AdminLayout
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using WebUI.Shared.Models.Payments
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Components
@inject IPaymentApi PaymentApi
@inject IToastService ToastService
@inject IDialogService DialogService

<PageTitle>Quản lý Giao dịch & Doanh thu | RATE ADMIN</PageTitle>

<div class="flex flex-col gap-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900">Hóa đơn & Doanh thu</h1>
            <p class="text-slate-500 font-medium">Giám sát các giao dịch thanh toán vé xem phim trong hệ thống</p>
        </div>
        
        <div class="bg-white px-6 py-3 border border-slate-100 rounded-2xl shadow-sm flex items-center gap-4">
            <span class="text-slate-400 font-bold text-xs uppercase tracking-wider">Tổng doanh thu</span>
            <span class="text-2xl font-black text-accent">@TotalRevenue.ToString("N0") đ</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-20 bg-white rounded-[2rem] border border-slate-100 shadow-md">
            <FluentProgressRing></FluentProgressRing>
        </div>
    }
    else if (!payments.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-[2rem] border border-slate-100 shadow-md gap-4">
            <FluentIcon Value="@(new Size24.Money())" class="text-slate-200" />
            <p class="text-slate-400 font-bold">Chưa có giao dịch thanh toán nào.</p>
        </div>
    }
    else
    {
        <FluentCard class="p-0 overflow-hidden border-none shadow-md rounded-[2rem] bg-white">
            <FluentDataGrid Items="@payments.AsQueryable()" TGridItem="PaymentDto" ResizableColumns="true" Pagination="@pagination">
                <PropertyColumn Property="@(p => p.PaymentId)" Title="Mã Hóa Đơn" Sortable="true" Align="Align.Start" />
                <PropertyColumn Property="@(p => p.UserId)" Title="Khách hàng" Sortable="true" />
                <TemplateColumn Title="Bộ Phim">
                    <span class="font-bold text-slate-800">@(context.Movie?.Title ?? "Phim điện ảnh")</span>
                </TemplateColumn>
                <PropertyColumn Property="@(p => p.Amount)" Title="Số Tiền" Sortable="true" Format="N0" />
                <TemplateColumn Title="Phương thức">
                    <span class="capitalize font-medium">@context.PaymentMethod</span>
                </TemplateColumn>
                <TemplateColumn Title="Thời gian" Sortable="true">
                    <span>@GetDisplayTime(context.PaymentDatetime)</span>
                </TemplateColumn>

                <TemplateColumn Title="Hành động" Align="Align.End">
                    <div class="flex gap-2 justify-end">
                        <PermissionGate Permission="Permission.Bookings.Delete">
                            <FluentButton IconStart="@(new Size20.Delete())" Appearance="Appearance.Stealth" Color="Color.Error" OnClick="@(() => DeletePayment(context))">Hủy bỏ</FluentButton>
                        </PermissionGate>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
            
            <div class="p-4 border-t bg-slate-50 flex justify-center">
                <FluentPaginator State="@pagination" />
            </div>
        </FluentCard>
    }
</div>

@code {
    private List<PaymentDto> payments = new();
    private bool isLoading = true;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    private decimal TotalRevenue => payments.Sum(p => p.Amount);

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        try
        {
            isLoading = true;
            var res = await PaymentApi.GetAllAsync();
            payments = res.Body ?? new List<PaymentDto>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi khi tải danh sách hóa đơn: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetDisplayTime(string datetimeStr)
    {
        return DateTime.TryParse(datetimeStr, out var dt) 
            ? dt.ToString("HH:mm, dd/MM/yyyy") 
            : datetimeStr;
    }

    private async Task DeletePayment(PaymentDto payment)
    {
        var confirm = await DialogService.ShowConfirmationAsync(
            $"Bạn có muốn hủy hóa đơn #{payment.PaymentId} và hoàn lại số tiền {payment.Amount.ToString("N0")} đ?",
            "Hoàn tiền", "Hủy bỏ", "Hoàn tiền giao dịch");

        var result = await confirm.Result;
        if (!result.Cancelled)
        {
            try
            {
                await PaymentApi.DeleteAsync(payment.PaymentId);
                ToastService.ShowSuccess("Đã hoàn tiền và xóa hóa đơn thành công!");
                await LoadPayments();
            }
            catch (Exception ex)
            {
                ToastService.ShowError("Hoàn tiền thất bại: " + ex.Message);
            }
        }
    }
}
