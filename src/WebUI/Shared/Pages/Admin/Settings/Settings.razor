@page "/admin/settings"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.UI
@inject IPermissionApi PermissionApi
@inject AdminMockDataService MockData
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Cài đặt | RATE Admin</PageTitle>

<PageHeader Title="Cài đặt"
            Description="Quản lý nhóm người dùng, tài khoản và danh sách quyền của hệ thống." />

@if (_hasLoadIssue)
{
    <MudAlert Severity="MudBlazor.Severity.Warning" Variant="MudBlazor.Variant.Outlined" Class="mb-4">
        Một số API phân quyền chưa phản hồi. Trang đang dùng dữ liệu fallback cho phần còn lại.
    </MudAlert>
}

<MudTabs Rounded="true" Elevation="0" Color="MudBlazor.Color.Primary">
    <MudTabPanel Text="Nhóm người dùng" Icon="@MudBlazor.Icons.Material.Outlined.Groups">
        <div class="rate-toolbar">
            <SearchBox @bind-Value="_roleSearch" Placeholder="Tìm nhóm người dùng..." />
            <PrimaryButton Icon="@MudBlazor.Icons.Material.Outlined.Add" OnClick="@CreateRole">Tạo nhóm</PrimaryButton>
        </div>

        @if (_isLoading)
        {
            <DataCard Class="rate-card-section"><MudSkeleton Height="180px" /></DataCard>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                @foreach (var role in FilteredRoles)
                {
                    <DataCard Class="rate-card-section">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <Badge Tone="primary">@role.NormalizedName</Badge>
                                <h2 class="rate-card-title mt-3 mb-1">@role.Name</h2>
                                <p class="text-sm text-slate-500">Mã định danh: @role.Id</p>
                            </div>
                            <div class="flex gap-1">
                                <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Sửa quyền" Intent="primary" OnClick="@(() => EditRole(role))" />
                                <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa nhóm" Intent="danger" OnClick="@(() => DeleteRole(role))" />
                            </div>
                        </div>
                        <div class="mt-4 pt-4 border-t border-slate-200 flex items-center justify-between">
                            <span class="text-sm text-slate-500">@role.PermissionsCount quyền hoạt động</span>
                            <MudButton Variant="MudBlazor.Variant.Text" Color="MudBlazor.Color.Primary" OnClick="@(() => EditRole(role))">Chi tiết quyền</MudButton>
                        </div>
                    </DataCard>
                }
            </div>
        }
    </MudTabPanel>

    <MudTabPanel Text="Người dùng" Icon="@MudBlazor.Icons.Material.Outlined.Person">
        <DataCard>
            <div class="rate-toolbar">
                <SearchBox @bind-Value="_userSearch" Placeholder="Tìm người dùng..." />
                <Badge Tone="primary">@FilteredUsers.Count() người dùng</Badge>
            </div>

            <DataTable TItem="UserProfileDto" Items="@FilteredUsers" EmptyMessage="Không có người dùng phù hợp.">
                <HeaderContent>
                    <MudTh>Người dùng</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Quyền</MudTh>
                    <MudTh Class="text-right">Hành động</MudTh>
                </HeaderContent>
                <RowTemplate Context="user">
                    <MudTd DataLabel="Người dùng"><strong>@user.UserName</strong></MudTd>
                    <MudTd DataLabel="Email">@user.Email</MudTd>
                    <MudTd DataLabel="Quyền"><Badge Tone="primary">@(user.Permissions.Count == 0 ? "User" : $"{user.Permissions.Count} quyền")</Badge></MudTd>
                    <MudTd DataLabel="Hành động" Class="text-right">
                        <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Chỉnh sửa" Intent="primary" OnClick="@(() => EditUser(user))" />
                        <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa" Intent="danger" OnClick="@(() => DeleteUser(user))" />
                    </MudTd>
                </RowTemplate>
            </DataTable>
        </DataCard>
    </MudTabPanel>

    <MudTabPanel Text="Quyền" Icon="@MudBlazor.Icons.Material.Outlined.Security">
        <DataState IsLoading="@_isLoading"
                   Error="@(_permissions.Count == 0 && _hasLoadIssue ? "load-failed" : null)"
                   IsEmpty="@(!_permissions.Any())"
                   OnRetry="@LoadSettings">
            <DataCard>
                <div class="rate-toolbar">
                    <SearchBox @bind-Value="_permissionSearch" Placeholder="Tìm quyền..." />
                    <Badge Tone="primary">@FilteredPermissions.Count() quyền</Badge>
                </div>

                <DataTable TItem="PermissionModel" Items="@FilteredPermissions" EmptyMessage="Không tìm thấy quyền phù hợp.">
                    <HeaderContent>
                        <MudTh>Token quyền</MudTh>
                        <MudTh>Phân loại</MudTh>
                        <MudTh>Trạng thái</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="permission">
                        <MudTd DataLabel="Token quyền"><strong>@permission.Name</strong></MudTd>
                        <MudTd DataLabel="Phân loại"><Badge Tone="info">@permission.Category</Badge></MudTd>
                        <MudTd DataLabel="Trạng thái"><Badge Tone="success">Active</Badge></MudTd>
                    </RowTemplate>
                </DataTable>
            </DataCard>
        </DataState>
    </MudTabPanel>
</MudTabs>

@code {
    private readonly List<RoleDto> _roles = [];
    private readonly List<string> _permissions = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _roleSearch = "";
    private string _userSearch = "";
    private string _permissionSearch = "";

    private IEnumerable<RoleDto> FilteredRoles => _roles
        .Where(role => string.IsNullOrWhiteSpace(_roleSearch)
            || role.Name.Contains(_roleSearch, StringComparison.OrdinalIgnoreCase)
            || role.NormalizedName.Contains(_roleSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<UserProfileDto> FilteredUsers => MockData.GetUsers()
        .Where(user => string.IsNullOrWhiteSpace(_userSearch)
            || user.UserName.Contains(_userSearch, StringComparison.OrdinalIgnoreCase)
            || user.Email.Contains(_userSearch, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<PermissionModel> FilteredPermissions => _permissions
        .Select(permission => new PermissionModel(permission))
        .Where(permission => string.IsNullOrWhiteSpace(_permissionSearch)
            || permission.Name.Contains(_permissionSearch, StringComparison.OrdinalIgnoreCase)
            || permission.Category.Contains(_permissionSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _roles.Clear();
            _roles.AddRange(await PermissionApi.GetAllRolesAsync() ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
            _roles.Clear();
            _roles.AddRange([
                new RoleDto("admin", "Admin", "ADMIN", 16),
                new RoleDto("manager", "Manager", "MANAGER", 8),
                new RoleDto("staff", "Staff", "STAFF", 4)
            ]);
        }

        try
        {
            _permissions.Clear();
            _permissions.AddRange(await PermissionApi.GetAllPermissionsAsync() ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
            _permissions.Clear();
            _permissions.AddRange([
                "Permission.Movies.Create",
                "Permission.Movies.Edit",
                "Permission.Movies.Delete",
                "Permission.Bookings.Edit",
                "Permission.ManagePermissions"
            ]);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CreateRole()
    {
        var roleName = await JSRuntime.InvokeAsync<string>("prompt", "Nhập tên nhóm người dùng:", "");
        if (string.IsNullOrWhiteSpace(roleName))
        {
            return;
        }

        Snackbar.Add("API tạo nhóm quyền chưa sẵn sàng.", MudBlazor.Severity.Info);
    }

    private void EditRole(RoleDto role) => Snackbar.Add($"Đang cấu hình nhóm {role.Name}.", MudBlazor.Severity.Info);

    private async Task DeleteRole(RoleDto role)
    {
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", $"Xóa nhóm '{role.Name}'?");
        if (ok)
        {
            Snackbar.Add("API xóa nhóm quyền chưa sẵn sàng.", MudBlazor.Severity.Info);
        }
    }

    private void EditUser(UserProfileDto user) => Snackbar.Add($"API cập nhật {user.UserName} chưa sẵn sàng.", MudBlazor.Severity.Info);
    private void DeleteUser(UserProfileDto user) => Snackbar.Add($"API xóa {user.UserName} chưa sẵn sàng.", MudBlazor.Severity.Warning);

    public record PermissionModel(string Name)
    {
        public string Category => Name.Contains('.', StringComparison.Ordinal) ? Name.Split('.')[1] : "Chung";
    }
}
