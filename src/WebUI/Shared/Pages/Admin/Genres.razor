@page "/admin/genres"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.UI
@inject IGenreApi GenreApi
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Thể loại | RATE Admin</PageTitle>

<PageHeader Title="Thể loại"
            Description="Quản lý danh mục thể loại phim dùng cho lọc, tìm kiếm và hiển thị nội dung.">
    <Actions>
        <PrimaryButton Icon="@MudBlazor.Icons.Material.Outlined.Add" OnClick="@(() => OpenGenreDialog(null))">Thêm thể loại</PrimaryButton>
    </Actions>
</PageHeader>

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_genres.Any())"
           OnRetry="@LoadGenres">
    <DataCard>
        <div class="rate-toolbar">
            <SearchBox @bind-Value="_searchText" Placeholder="Tìm thể loại..." />
            <Badge Tone="primary">@FilteredGenres.Count() thể loại</Badge>
        </div>

        <DataTable TItem="GenreDto" Items="@PagedGenres" EmptyMessage="Không tìm thấy thể loại phù hợp.">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Tên thể loại</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="genre">
                <MudTd DataLabel="ID">#@genre.Id</MudTd>
                <MudTd DataLabel="Tên thể loại"><strong>@genre.Name</strong></MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Chỉnh sửa" Intent="primary" OnClick="@(() => OpenGenreDialog(genre))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa" Intent="danger" OnClick="@(() => ConfirmDeleteGenre(genre))" />
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredGenres.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<GenreDto> _genres = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<GenreDto> FilteredGenres => _genres
        .Where(genre => string.IsNullOrWhiteSpace(_searchText) || genre.Name.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<GenreDto> PagedGenres => FilteredGenres
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadGenres();
    }

    private async Task LoadGenres()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _genres.Clear();
            _genres.AddRange(await GenreApi.GetAllAsync() ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private async Task OpenGenreDialog(GenreDto? genre)
    {
        var isNew = genre is null;
        var currentName = genre?.Name ?? "";
        var value = await JSRuntime.InvokeAsync<string>("prompt", isNew ? "Nhập tên thể loại mới:" : "Chỉnh sửa tên thể loại:", currentName);

        if (value is null)
        {
            return;
        }

        value = value.Trim();
        if (string.IsNullOrWhiteSpace(value))
        {
            Snackbar.Add("Tên thể loại không được để trống.", MudBlazor.Severity.Warning);
            return;
        }

        try
        {
            if (isNew)
            {
                await GenreApi.CreateAsync(new CreateGenreCommand(value));
                Snackbar.Add("Đã thêm thể loại.", MudBlazor.Severity.Success);
            }
            else
            {
                await GenreApi.UpdateAsync(new UpdateGenreCommand(genre!.Id, value));
                Snackbar.Add("Đã cập nhật thể loại.", MudBlazor.Severity.Success);
            }

            await LoadGenres();
        }
        catch
        {
            Snackbar.Add("Không thể lưu thể loại lúc này.", MudBlazor.Severity.Error);
        }
    }

    private async Task ConfirmDeleteGenre(GenreDto genre)
    {
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", $"Xóa thể loại '{genre.Name}'?");
        if (!ok)
        {
            return;
        }

        try
        {
            await GenreApi.DeleteAsync(genre.Id);
            Snackbar.Add("Đã xóa thể loại.", MudBlazor.Severity.Success);
            await LoadGenres();
        }
        catch
        {
            Snackbar.Add("Không thể xóa thể loại lúc này.", MudBlazor.Severity.Error);
        }
    }
}
