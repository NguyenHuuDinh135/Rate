@page "/admin/genres"
@layout AdminLayout
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using WebUI.Shared.Models.Movies
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Components
@inject IGenreApi GenreApi
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

<PageTitle>Quản lý Thể loại | RATE ADMIN</PageTitle>

<div class="flex flex-col gap-8">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-black tracking-tight text-slate-900">Quản lý Thể loại</h1>
            <p class="text-slate-500 font-medium">Danh mục các thể loại phim trong hệ thống</p>
        </div>
        <PermissionGate Permission="Permission.Movies.Create">
            <FluentButton Appearance="Appearance.Accent" IconStart="@(new Size20.Add())" class="h-12 px-6 font-bold shadow-lg shadow-accent/20 rounded-xl" OnClick="@(() => OpenGenreDialog(null))">
                Thêm thể loại mới
            </FluentButton>
        </PermissionGate>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-20 bg-white rounded-[2rem] border border-slate-100 shadow-md">
            <FluentProgressRing></FluentProgressRing>
        </div>
    }
    else if (!genres.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-[2rem] border border-slate-100 shadow-md gap-4">
            <FluentIcon Value="@(new Size32.Tag())" class="text-slate-200" />
            <p class="text-slate-400 font-bold">Chưa có thể loại nào.</p>
        </div>
    }
    else
    {
        <FluentCard class="p-0 overflow-hidden border-none shadow-md rounded-[2rem] bg-white">
            <FluentDataGrid Items="@genres.AsQueryable()" TGridItem="GenreDto" ResizableColumns="true" Pagination="@pagination">
                <PropertyColumn Property="@(g => g.Id)" Title="ID Thể loại" Sortable="true" Align="Align.Start" />
                <PropertyColumn Property="@(g => g.Name)" Title="Tên Thể loại" Sortable="true" />
                
                <TemplateColumn Title="Hành động" Align="Align.End">
                    <div class="flex gap-2 justify-end">
                        <PermissionGate Permission="Permission.Movies.Edit">
                            <FluentButton IconStart="@(new Size20.Edit())" Appearance="Appearance.Stealth" OnClick="@(() => OpenGenreDialog(context))" />
                        </PermissionGate>
                        <PermissionGate Permission="Permission.Movies.Delete">
                            <FluentButton IconStart="@(new Size20.Delete())" Appearance="Appearance.Stealth" Color="Color.Error" OnClick="@(() => ConfirmDeleteGenre(context))" />
                        </PermissionGate>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
            
            <div class="p-4 border-t bg-slate-50 flex justify-center">
                <FluentPaginator State="@pagination" />
            </div>
        </FluentCard>
    }
</div>

@code {
    private List<GenreDto> genres = new();
    private bool isLoading = true;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        await LoadGenres();
    }

    private async Task LoadGenres()
    {
        try
        {
            isLoading = true;
            genres = await GenreApi.GetAllAsync() ?? new List<GenreDto>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi khi tải danh sách thể loại: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenGenreDialog(GenreDto? genre)
    {
        var isNew = genre == null;
        var nameInput = genre?.Name ?? "";

        var newName = await JSRuntime.InvokeAsync<string>("prompt", isNew ? "Nhập tên thể loại mới:" : "Chỉnh sửa tên thể loại:", nameInput);

        if (newName != null)
        {
            newName = newName.Trim();
            if (string.IsNullOrWhiteSpace(newName))
            {
                ToastService.ShowError("Tên thể loại không được để trống!");
                return;
            }

            try
            {
                if (isNew)
                {
                    await GenreApi.CreateAsync(new CreateGenreCommand(newName));
                    ToastService.ShowSuccess("Thêm thể loại thành công!");
                }
                else
                {
                    await GenreApi.UpdateAsync(new UpdateGenreCommand(genre!.Id, newName));
                    ToastService.ShowSuccess("Cập nhật thể loại thành công!");
                }
                await LoadGenres();
            }
            catch (Exception ex)
            {
                ToastService.ShowError("Thao tác thất bại: " + ex.Message);
            }
        }
    }

    private async Task ConfirmDeleteGenre(GenreDto genre)
    {
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", $"Bạn có chắc chắn muốn xóa thể loại '{genre.Name}'?");
        if (ok)
        {
            try
            {
                await GenreApi.DeleteAsync(genre.Id);
                ToastService.ShowSuccess("Xóa thể loại thành công!");
                await LoadGenres();
            }
            catch (Exception ex)
            {
                ToastService.ShowError("Xóa thất bại: " + ex.Message);
            }
        }
    }
}
