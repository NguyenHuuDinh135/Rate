@page "/admin/bookings"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.UI
@inject IBookingApi BookingApi
@inject MudBlazor.ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<PageTitle>Đặt vé | RATE Admin</PageTitle>

<PageHeader Title="Đặt vé"
            Description="Theo dõi vé đã đặt, trạng thái giữ ghế, thanh toán và hủy vé." />

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_bookings.Any())"
           OnRetry="@LoadBookings">
    <DataCard>
        <div class="rate-toolbar">
            <div class="rate-toolbar__left">
                <SearchBox @bind-Value="_searchText" Placeholder="Tìm mã vé, người đặt, ghế..." />
                <MudSelect T="string" @bind-Value="_statusFilter" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Dense="true" Class="min-w-40">
                    <MudSelectItem T="string" Value="@("all")">Tất cả trạng thái</MudSelectItem>
                    <MudSelectItem T="string" Value="@("confirmed")">Đã xác nhận</MudSelectItem>
                    <MudSelectItem T="string" Value="@("reserved")">Giữ ghế</MudSelectItem>
                    <MudSelectItem T="string" Value="@("cancelled")">Đã hủy</MudSelectItem>
                </MudSelect>
            </div>
            <Badge Tone="primary">@FilteredBookings.Count() vé</Badge>
        </div>

        <DataTable TItem="BookingDto" Items="@PagedBookings" EmptyMessage="Không tìm thấy đặt vé phù hợp.">
            <HeaderContent>
                <MudTh>Mã vé</MudTh>
                <MudTh>Người đặt</MudTh>
                <MudTh>Suất chiếu</MudTh>
                <MudTh>Ghế</MudTh>
                <MudTh>Giá</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="booking">
                <MudTd DataLabel="Mã vé">#@booking.Id</MudTd>
                <MudTd DataLabel="Người đặt">@DisplayText(booking.UserId)</MudTd>
                <MudTd DataLabel="Suất chiếu">#@booking.ShowId</MudTd>
                <MudTd DataLabel="Ghế"><Badge>@($"{booking.SeatRow}{booking.SeatNumber}")</Badge></MudTd>
                <MudTd DataLabel="Giá">@FormatCurrency(booking.Price)</MudTd>
                <MudTd DataLabel="Trạng thái"><Badge Tone="@BookingTone(booking.Status)">@BookingLabel(booking.Status)</Badge></MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Visibility" Title="Xem chi tiết" OnClick="@(() => ViewBooking(booking))" />
                    @if (booking.Status != BookingStatus.Cancelled)
                    {
                        <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Cancel" Title="Hủy vé" Intent="danger" OnClick="@(() => CancelBooking(booking))" />
                    }
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredBookings.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<BookingDto> _bookings = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private string _statusFilter = "all";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<BookingDto> FilteredBookings => _bookings
        .Where(booking => string.IsNullOrWhiteSpace(_searchText)
            || booking.Id.ToString().Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || DisplayText(booking.UserId).Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            || $"{booking.SeatRow}{booking.SeatNumber}".Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(booking => _statusFilter switch
        {
            "confirmed" => booking.Status == BookingStatus.Confirmed,
            "reserved" => booking.Status == BookingStatus.Reserved,
            "cancelled" => booking.Status == BookingStatus.Cancelled,
            _ => true
        });

    private IEnumerable<BookingDto> PagedBookings => FilteredBookings
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _bookings.Clear();
            var response = await BookingApi.GetAllAsync();
            _bookings.AddRange(response?.Body ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private void ViewBooking(BookingDto booking)
    {
        Snackbar.Add($"Đang xem đặt vé #{booking.Id}.", MudBlazor.Severity.Info);
    }

    private async Task CancelBooking(BookingDto booking)
    {
        var ok = await JSRuntime.InvokeAsync<bool>("confirm", $"Hủy vé #{booking.Id} và giải phóng ghế {booking.SeatRow}{booking.SeatNumber}?");
        if (!ok)
        {
            return;
        }

        try
        {
            await BookingApi.UpdateAsync(new UpdateBookingCommand(
                booking.Id,
                booking.SeatRow ?? string.Empty,
                booking.SeatNumber ?? 0,
                (float)booking.Price,
                BookingStatus.Cancelled));
            Snackbar.Add("Đã hủy đặt vé.", MudBlazor.Severity.Success);
            await LoadBookings();
        }
        catch
        {
            Snackbar.Add("Không thể hủy đặt vé lúc này.", MudBlazor.Severity.Error);
        }
    }

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatCurrency(decimal amount) => $"{amount:N0} đ";

    private static string BookingLabel(BookingStatus status) => status switch
    {
        BookingStatus.Confirmed => "Đã xác nhận",
        BookingStatus.Reserved => "Giữ ghế",
        BookingStatus.Cancelled => "Đã hủy",
        _ => "Không rõ"
    };

    private static string BookingTone(BookingStatus status) => status switch
    {
        BookingStatus.Confirmed => "success",
        BookingStatus.Reserved => "warning",
        BookingStatus.Cancelled => "danger",
        _ => "neutral"
    };
}
