@page "/admin/bookings"
@layout AdminLayout
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using WebUI.Shared.Models.Bookings
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Components
@inject IBookingApi BookingApi
@inject IToastService ToastService
@inject IDialogService DialogService

<PageTitle>Quản lý Vé Đã Đặt | RATE ADMIN</PageTitle>

<div class="flex flex-col gap-8">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900">Quản lý Vé Đã Đặt</h1>
        <p class="text-slate-500 font-medium">Danh sách và trạng thái toàn bộ vé ghế đã bán trên hệ thống</p>
    </div>

    @if (isLoading)
    {
        <div class="flex justify-center py-20 bg-white rounded-[2rem] border border-slate-100 shadow-md">
            <FluentProgressRing></FluentProgressRing>
        </div>
    }
    else if (!bookings.Any())
    {
        <div class="flex flex-col items-center justify-center py-20 bg-white rounded-[2rem] border border-slate-100 shadow-md gap-4">
            <FluentIcon Value="@(new Size32.Document())" class="text-slate-200" />
            <p class="text-slate-400 font-bold">Chưa có vé nào được đặt.</p>
        </div>
    }
    else
    {
        <FluentCard class="p-0 overflow-hidden border-none shadow-md rounded-[2rem] bg-white">
            <FluentDataGrid Items="@bookings.AsQueryable()" TGridItem="BookingDto" ResizableColumns="true" Pagination="@pagination">
                <PropertyColumn Property="@(b => b.Id)" Title="Mã Vé" Sortable="true" Align="Align.Start" />
                <PropertyColumn Property="@(b => b.UserId)" Title="Người đặt" Sortable="true" />
                <PropertyColumn Property="@(b => b.ShowId)" Title="Mã Suất Chiếu" Sortable="true" />
                <TemplateColumn Title="Ghế Ngồi">
                    <FluentBadge Appearance="Appearance.Neutral" class="font-black">@($"{context.SeatRow}{context.SeatNumber}")</FluentBadge>
                </TemplateColumn>
                <PropertyColumn Property="@(b => b.Price)" Title="Giá Vé" Sortable="true" Format="N0" />
                <TemplateColumn Title="Trạng thái" Sortable="true">
                    @if (context.Status == BookingStatus.Paid)
                    {
                        <FluentBadge Appearance="Appearance.Lightweight" Fill="success">Đã thanh toán</FluentBadge>
                    }
                    else if (context.Status == BookingStatus.Reserved)
                    {
                        <FluentBadge Appearance="Appearance.Lightweight" Fill="warning">Đang giữ ghế</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="Appearance.Lightweight" Fill="danger">Đã hủy</FluentBadge>
                    }
                </TemplateColumn>

                <TemplateColumn Title="Hành động" Align="Align.End">
                    <div class="flex gap-2 justify-end">
                        <PermissionGate Permission="Permission.Bookings.Edit">
                            @if (context.Status != BookingStatus.Cancelled)
                            {
                                <FluentButton IconStart="@(new Size20.Delete())" Appearance="Appearance.Stealth" Color="Color.Error" OnClick="@(() => CancelBooking(context))">Hủy vé</FluentButton>
                            }
                        </PermissionGate>
                    </div>
                </TemplateColumn>
            </FluentDataGrid>
            
            <div class="p-4 border-t bg-slate-50 flex justify-center">
                <FluentPaginator State="@pagination" />
            </div>
        </FluentCard>
    }
</div>

@code {
    private List<BookingDto> bookings = new();
    private bool isLoading = true;
    private PaginationState pagination = new PaginationState { ItemsPerPage = 10 };

    protected override async Task OnInitializedAsync()
    {
        await LoadBookings();
    }

    private async Task LoadBookings()
    {
        try
        {
            isLoading = true;
            bookings = await BookingApi.GetAllAsync() ?? new List<BookingDto>();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Lỗi khi tải danh sách vé: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CancelBooking(BookingDto booking)
    {
        var confirm = await DialogService.ShowConfirmationAsync(
            $"Bạn có chắc chắn muốn hủy và giải phóng ghế '{booking.SeatRow}{booking.SeatNumber}' của vé #{booking.Id}?",
            "Hủy vé", "Quay lại", "Xác nhận hủy đặt vé");

        var result = await confirm.Result;
        if (!result.Cancelled)
        {
            try
            {
                // Status 2 is Cancelled in standard booking flow
                await BookingApi.UpdateAsync(new UpdateBookingCommand(booking.Id, 2));
                ToastService.ShowSuccess("Đã hủy vé đặt thành công!");
                await LoadBookings();
            }
            catch (Exception ex)
            {
                ToastService.ShowError("Hủy đặt vé thất bại: " + ex.Message);
            }
        }
    }
}
