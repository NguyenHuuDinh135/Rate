@page "/admin"
@layout AdminLayout
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using WebUI.Shared.Models.Common
@using WebUI.Shared.Services.Api
@inject IMovieApi MovieApi
@inject IShowApi ShowApi
@inject IBookingApi BookingApi
@inject IPaymentApi PaymentApi

<div class="flex flex-col gap-8">
    <div>
        <h1 class="text-3xl font-black tracking-tight text-slate-900">Tổng quan hệ thống</h1>
        <p class="text-slate-500 font-medium">Chào mừng bạn trở lại trang quản trị RATE.</p>
    </div>

    @* Stat Cards *@
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <StatCard Title="Doanh thu" Value="125.4M đ" Delta="+12%" Icon="@(new Size24.Money())" Color="bg-emerald-500" />
        <StatCard Title="Vé đã bán" Value="1,240" Delta="+5%" Icon="@(new Size24.MoviesAndTv())" Color="bg-blue-500" />
        <StatCard Title="Phim đang chiếu" Value="12" Delta="0" Icon="@(new Size24.MoviesAndTv())" Color="bg-amber-500" />
        <StatCard Title="Người dùng mới" Value="85" Delta="+18%" Icon="@(new Size24.People())" Color="bg-purple-500" />
    </div>

    @* Chart & Recent Bookings *@
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <div class="lg:col-span-8">
            <FluentCard class="p-8 rounded-[2rem] shadow-md border-none h-[400px] flex items-center justify-center bg-white">
                <div class="text-center space-y-4">
                    <FluentIcon Value="@(new Size24.Settings())" class="mx-auto opacity-20" />
                    <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">Biểu đồ doanh thu (Placeholder)</p>
                </div>
            </FluentCard>
        </div>

        <div class="lg:col-span-4">
            <FluentCard class="p-8 rounded-[2rem] shadow-md border-none bg-white">
                <h3 class="font-black text-lg mb-6">Đơn hàng mới nhất</h3>
                <div class="flex flex-col gap-4">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="flex items-center gap-4 p-3 hover:bg-slate-50 rounded-xl transition-colors cursor-pointer">
                            <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                                <FluentIcon Value="@(new Size20.Person())" />
                            </div>
                            <div class="flex-1 overflow-hidden">
                                <p class="font-bold text-sm truncate">User_@(i+100)</p>
                                <p class="text-[10px] text-slate-400 font-bold">2 phút trước</p>
                            </div>
                            <span class="font-black text-sm text-accent">95K</span>
                        </div>
                    }
                </div>
            </FluentCard>
        </div>
    </div>
</div>

