@page "/admin"
@page "/admin/dashboard"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.UI
@using WebUI.Shared.Models.Common
@using WebUI.Shared.Services.Api
@inject IMovieApi MovieApi
@inject IShowApi ShowApi
@inject IBookingApi BookingApi
@inject IPaymentApi PaymentApi
@inject AdminMockDataService MockData

<PageTitle>Dashboard | RATE Admin</PageTitle>

<PageHeader Title="Dashboard"
            Description="Tổng quan doanh thu, lịch chiếu, đặt vé và hoạt động vận hành hệ thống." />

@if (_isLoading)
{
    <div class="rate-stat-grid">
        @for (var i = 0; i < 4; i++)
        {
            <DataCard Class="rate-card-section">
                <MudSkeleton Height="22px" Width="40%" />
                <MudSkeleton Height="34px" Width="70%" Class="mt-3" />
            </DataCard>
        }
    </div>
}
else
{
    @if (_hasLoadIssue)
    {
        <MudAlert Severity="MudBlazor.Severity.Warning" Variant="MudBlazor.Variant.Outlined" Class="mb-4">
            Một số dữ liệu chưa sẵn sàng. Dashboard đang hiển thị phần đã tải được.
        </MudAlert>
    }

    <div class="rate-stat-grid">
        <WebUI.Shared.Components.Admin.StatCard Title="Doanh thu"
                                                Value="@FormatCurrency(_payments.Sum(p => p.Amount))"
                                                Delta="+12%"
                                                Icon="@MudBlazor.Icons.Material.Outlined.Payments"
                                                Tone="success" />
        <WebUI.Shared.Components.Admin.StatCard Title="Vé đã đặt"
                                                Value="@_bookings.Count.ToString("N0")"
                                                Delta="+5%"
                                                Icon="@MudBlazor.Icons.Material.Outlined.ConfirmationNumber"
                                                Tone="info" />
        <WebUI.Shared.Components.Admin.StatCard Title="Phim"
                                                Value="@_movies.Count.ToString("N0")"
                                                Icon="@MudBlazor.Icons.Material.Outlined.Movie"
                                                Tone="warning" />
        <WebUI.Shared.Components.Admin.StatCard Title="Suất chiếu"
                                                Value="@_shows.Count.ToString("N0")"
                                                Icon="@MudBlazor.Icons.Material.Outlined.EventSeat" />
    </div>

    <div class="rate-grid-2">
        <DataCard>
            <div class="rate-card-section">
                <h2 class="rate-card-title">Đặt vé gần đây</h2>
            </div>
            <DataTable TItem="BookingDto" Items="@_recentBookings" EmptyMessage="Chưa có đặt vé nào.">
                <HeaderContent>
                    <MudTh>Mã vé</MudTh>
                    <MudTh>Người đặt</MudTh>
                    <MudTh>Ghế</MudTh>
                    <MudTh>Giá</MudTh>
                    <MudTh>Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate Context="booking">
                    <MudTd DataLabel="Mã vé">#@booking.Id</MudTd>
                    <MudTd DataLabel="Người đặt">@DisplayText(booking.UserId)</MudTd>
                    <MudTd DataLabel="Ghế">@($"{booking.SeatRow}{booking.SeatNumber}")</MudTd>
                    <MudTd DataLabel="Giá">@FormatCurrency(booking.Price)</MudTd>
                    <MudTd DataLabel="Trạng thái"><Badge Tone="@BookingTone(booking.Status)">@BookingLabel(booking.Status)</Badge></MudTd>
                </RowTemplate>
            </DataTable>
        </DataCard>

        <DataCard>
            <div class="rate-card-section">
                <h2 class="rate-card-title">Hoạt động người dùng</h2>
                <div class="rate-list">
                    @foreach (var item in MockData.GetActivities())
                    {
                        <div class="rate-list-row">
                            <div>
                                <strong>@item.Action</strong>
                                <span>@item.UserName · @item.TimeAgo</span>
                            </div>
                            <Badge Tone="primary">@item.Type</Badge>
                        </div>
                    }
                </div>
            </div>
        </DataCard>
    </div>
}

@code {
    private readonly List<MovieDto> _movies = [];
    private readonly List<ShowDto> _shows = [];
    private readonly List<BookingDto> _bookings = [];
    private readonly List<PaymentDto> _payments = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;

    private IEnumerable<BookingDto> _recentBookings => _bookings
        .OrderByDescending(b => b.Id)
        .Take(6);

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        await LoadSafely(async () => _movies.AddRange(await MovieApi.GetAllAsync()));
        await LoadSafely(async () => _shows.AddRange(await ShowApi.GetAllAsync()));
        await LoadSafely(async () => _bookings.AddRange(await BookingApi.GetAllAsync() ?? []));
        await LoadSafely(async () =>
        {
            var payments = await PaymentApi.GetAllAsync();
            _payments.AddRange(payments.Body ?? []);
        });

        _isLoading = false;
    }

    private async Task LoadSafely(Func<Task> load)
    {
        try
        {
            await load();
        }
        catch
        {
            _hasLoadIssue = true;
        }
    }

    private static string DisplayText(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatCurrency(decimal amount) => $"{amount:N0} đ";

    private static string BookingLabel(BookingStatus status) => status switch
    {
        BookingStatus.Paid => "Đã thanh toán",
        BookingStatus.Reserved => "Giữ ghế",
        BookingStatus.Cancelled => "Đã hủy",
        _ => "Không rõ"
    };

    private static string BookingTone(BookingStatus status) => status switch
    {
        BookingStatus.Paid => "success",
        BookingStatus.Reserved => "warning",
        BookingStatus.Cancelled => "danger",
        _ => "neutral"
    };
}
