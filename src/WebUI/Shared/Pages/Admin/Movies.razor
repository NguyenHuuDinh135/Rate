@page "/admin/movies"
@layout AdminLayout
@using MudBlazor
@using WebUI.Shared.Components.Admin
@using WebUI.Shared.Components.Admin.Dialogs
@using WebUI.Shared.Components.UI
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Models.Movies
@inject IMovieApi MovieApi
@inject MudBlazor.ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Quản lý phim | RATE Admin</PageTitle>

<PageHeader Title="Quản lý phim"
            Description="Quản lý danh sách phim, trạng thái phát hành và thông tin hiển thị trong hệ thống.">
    <Actions>
        <PrimaryButton Icon="@MudBlazor.Icons.Material.Outlined.Add" OnClick="@CreateMovie">Thêm phim</PrimaryButton>
    </Actions>
</PageHeader>

<DataState IsLoading="@_isLoading"
           Error="@(_hasLoadIssue ? "load-failed" : null)"
           IsEmpty="@(!_movies.Any())"
           OnRetry="@LoadMovies">
    <DataCard>
        <div class="rate-toolbar">
            <div class="rate-toolbar__left">
                <SearchBox @bind-Value="_searchText" Placeholder="Tìm theo tên phim..." />
                <MudSelect T="string" @bind-Value="_typeFilter" Variant="MudBlazor.Variant.Outlined" Margin="MudBlazor.Margin.Dense" Dense="true" Class="min-w-44">
                    <MudSelectItem T="string" Value="@("all")">Tất cả trạng thái</MudSelectItem>
                    <MudSelectItem T="string" Value="@("now")">Đang chiếu</MudSelectItem>
                    <MudSelectItem T="string" Value="@("soon")">Sắp chiếu</MudSelectItem>
                    <MudSelectItem T="string" Value="@("removed")">Đã gỡ</MudSelectItem>
                </MudSelect>
            </div>
            <div class="rate-toolbar__right">
                <Badge Tone="primary">@FilteredMovies.Count() phim</Badge>
            </div>
        </div>

        <DataTable TItem="MovieDto" Items="@PagedMovies" EmptyMessage="Không tìm thấy phim phù hợp.">
            <HeaderContent>
                <MudTh>Phim</MudTh>
                <MudTh>Năm</MudTh>
                <MudTh>Đánh giá</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh Class="text-right">Hành động</MudTh>
            </HeaderContent>
            <RowTemplate Context="movie">
                <MudTd DataLabel="Phim">
                    <div class="flex items-center gap-3">
                        <img src="@Poster(movie.PosterUrl)" alt="@movie.Title" class="h-12 w-9 rounded object-cover border border-slate-200" />
                        <div>
                            <div class="font-bold">@movie.Title</div>
                            <div class="text-xs text-slate-500">#@movie.Id</div>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Năm">@movie.Year</MudTd>
                <MudTd DataLabel="Đánh giá">@(movie.Rating?.ToString("0.0") ?? "-")</MudTd>
                <MudTd DataLabel="Trạng thái"><Badge Tone="@MovieTone(movie.MovieType)">@MovieLabel(movie.MovieType)</Badge></MudTd>
                <MudTd DataLabel="Hành động" Class="text-right">
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Visibility" Title="Xem chi tiết" OnClick="@(() => ViewMovie(movie))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Edit" Title="Chỉnh sửa" Intent="primary" OnClick="@(() => EditMovie(movie))" />
                    <IconButton Icon="@MudBlazor.Icons.Material.Outlined.Delete" Title="Xóa" Intent="danger" OnClick="@(() => DeleteMovie(movie))" />
                </MudTd>
            </RowTemplate>
        </DataTable>

        <Pagination Page="@_page" PageChanged="@OnPageChanged" PageSize="@_pageSize" TotalItems="@FilteredMovies.Count()" />
    </DataCard>
</DataState>

@code {
    private readonly List<MovieDto> _movies = [];
    private bool _isLoading = true;
    private bool _hasLoadIssue;
    private string _searchText = "";
    private string _typeFilter = "all";
    private int _page = 1;
    private const int _pageSize = 10;

    private IEnumerable<MovieDto> FilteredMovies => _movies
        .Where(movie => string.IsNullOrWhiteSpace(_searchText) || movie.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
        .Where(movie => _typeFilter switch
        {
            "now" => movie.MovieType == MovieType.NowShowing,
            "soon" => movie.MovieType == MovieType.ComingSoon,
            "removed" => movie.MovieType == MovieType.Removed,
            _ => true
        });

    private IEnumerable<MovieDto> PagedMovies => FilteredMovies
        .Skip((_page - 1) * _pageSize)
        .Take(_pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadMovies();
    }

    private async Task LoadMovies()
    {
        _isLoading = true;
        _hasLoadIssue = false;

        try
        {
            _movies.Clear();
            var response = await MovieApi.GetAllAsync();
            _movies.AddRange(response.Body ?? []);
        }
        catch
        {
            _hasLoadIssue = true;
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private Task OnPageChanged(int page)
    {
        _page = page;
        return Task.CompletedTask;
    }

    private async Task CreateMovie()
    {
        var dialog = await DialogService.ShowAsync<AdminMovieDialog>(
            "Thêm phim mới", 
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is AdminMovieDialog.MovieFormModel model)
        {
            try
            {
                var response = await MovieApi.CreateAsync(new CreateMovieCommand(
                    model.Title,
                    model.Summary,
                    model.Year,
                    model.Rating,
                    model.TrailerUrl,
                    model.PosterUrl,
                    (int)model.MovieType));
                
                Snackbar.Add(response.Succeeded ? "Đã tạo phim." : "Không thể tạo phim lúc này.", response.Succeeded ? MudBlazor.Severity.Success : MudBlazor.Severity.Error);
                await LoadMovies();
            }
            catch
            {
                Snackbar.Add("Không thể tạo phim lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private void ViewMovie(MovieDto movie)
    {
        Snackbar.Add($"Đang xem phim: {movie.Title}", MudBlazor.Severity.Info);
    }

    private async Task EditMovie(MovieDto movie)
    {
        var parameters = new DialogParameters
        {
            { "Movie", movie }
        };

        var dialog = await DialogService.ShowAsync<AdminMovieDialog>(
            "Chỉnh sửa phim", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled && result.Data is AdminMovieDialog.MovieFormModel model)
        {
            try
            {
                await MovieApi.UpdateAsync(new UpdateMovieCommand(
                    movie.Id,
                    model.Title,
                    model.Summary,
                    model.Year,
                    model.Rating,
                    model.TrailerUrl,
                    model.PosterUrl,
                    (int)model.MovieType));
                
                Snackbar.Add("Đã cập nhật phim.", MudBlazor.Severity.Success);
                await LoadMovies();
            }
            catch
            {
                Snackbar.Add("Không thể cập nhật phim lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private async Task DeleteMovie(MovieDto movie)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Bạn có chắc chắn muốn xóa phim '{movie.Title}' không?" },
            { "ButtonText", "Xóa phim" }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDeleteDialog>(
            "Xác nhận xóa", 
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }
        );

        var result = await dialog.Result;

        if (!result!.Canceled)
        {
            try
            {
                await MovieApi.DeleteAsync(movie.Id);
                Snackbar.Add("Đã xóa phim.", MudBlazor.Severity.Success);
                await LoadMovies();
            }
            catch
            {
                Snackbar.Add("Không thể xóa phim lúc này.", MudBlazor.Severity.Error);
            }
        }
    }

    private static string Poster(string? posterUrl) => string.IsNullOrWhiteSpace(posterUrl) ? "/favicon.png" : posterUrl;

    private static string MovieLabel(MovieType type) => type switch
    {
        MovieType.NowShowing => "Đang chiếu",
        MovieType.ComingSoon => "Sắp chiếu",
        MovieType.Removed => "Đã gỡ",
        _ => "Không rõ"
    };

    private static string MovieTone(MovieType type) => type switch
    {
        MovieType.NowShowing => "success",
        MovieType.ComingSoon => "warning",
        MovieType.Removed => "danger",
        _ => "neutral"
    };
}
