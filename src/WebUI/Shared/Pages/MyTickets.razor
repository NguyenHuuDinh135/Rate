@page "/my-tickets"
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@using WebUI.Shared.Models.Payments
@using WebUI.Shared.Services.Api
@inject IPaymentApi PaymentApi
@inject IToastService ToastService

<div class="min-h-screen bg-slate-50 pt-24 pb-20">
    <div class="container mx-auto max-w-5xl px-4 flex flex-col gap-10">
        
        @* Header *@
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div>
                <h1 class="text-4xl font-black tracking-tight flex items-center gap-4 text-slate-900">
                    <div class="w-12 h-12 bg-accent rounded-2xl flex items-center justify-center text-white shadow-lg shadow-accent/20">
                        <FluentIcon Value="@(new Size24.MoviesAndTv())" />
                    </div>
                    Vé Của Tôi
                </h1>
                <p class="text-slate-500 font-bold mt-2 ml-16">Quản lý vé đã đặt và lịch sử xem phim của bạn.</p>
            </div>
            
            <div class="relative w-full md:w-80">
                <FluentTextField Placeholder="Tìm tên phim, mã vé..." class="w-full h-12 rounded-xl shadow-sm border-none bg-white px-4" />
            </div>
        </div>

        @* Tabs *@
        <FluentTabs ActiveTabId="upcoming" class="w-full">
            <FluentTab Id="upcoming" Label="SẮP CHIẾU">
                <div class="grid gap-6 py-8">
                    @if (isLoading)
                    {
                        @for (int i = 0; i < 3; i++)
                        {
                            <FluentSkeleton class="h-48 w-full rounded-[2.5rem]" />
                        }
                    }
                    else if (payments.Any())
                    {
                        @foreach (var payment in payments)
                        {
                            <TicketListItem Payment="@payment" />
                        }
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center py-24 bg-white rounded-[3rem] border border-slate-100 shadow-sm space-y-6">
                            <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center text-slate-200">
                                <FluentIcon Value="@(new Size48.History())" />
                            </div>
                            <div class="text-center">
                                <h3 class="text-xl font-black text-slate-900">Chưa có vé nào</h3>
                                <p class="text-slate-400 font-medium mt-1">Bạn chưa có lịch chiếu nào sắp tới. Đặt vé ngay!</p>
                            </div>
                            <FluentAnchor Href="/" Appearance="Appearance.Accent" class="h-12 px-8 rounded-xl font-black shadow-lg shadow-accent/20">Khám phá phim mới</FluentAnchor>
                        </div>
                    }
                </div>
            </FluentTab>
            <FluentTab Id="history" Label="LỊCH SỬ" />
            <FluentTab Id="all" Label="TẤT CẢ" />
        </FluentTabs>
    </div>
</div>

@code {
    private List<PaymentDto> payments = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await PaymentApi.GetAllAsync();
            payments = response?.Body ?? new List<PaymentDto>();
        }
        catch (Exception) { }
        finally
        {
            isLoading = false;
        }
    }
}
