@page "/movies/{Id:int}"
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@using Fluxor
@using WebUI.Shared.Store.Movies
@using WebUI.Shared.Store.Auth
@using WebUI.Shared.Models.Movies
@using WebUI.Shared.Models.Theaters
@using WebUI.Shared.Models.Bookings
@using WebUI.Shared.Models.Payments
@using WebUI.Shared.Services.Api
@using WebUI.Shared.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular
@inject IState<MovieState> MovieState
@inject IState<AuthState> AuthState
@inject IDispatcher Dispatcher
@inject IShowApi ShowApi
@inject ITheaterApi TheaterApi
@inject IBookingApi BookingApi
@inject IPaymentApi PaymentApi
@inject Microsoft.FluentUI.AspNetCore.Components.IDialogService DialogService
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@inject IPersonApi PersonApi

@if (MovieState.Value.IsLoading && MovieState.Value.SelectedMovie == null)
{
    <div class="flex flex-col items-center justify-center min-h-[60vh] gap-4">
        <div class="w-12 h-12 rounded-full border-4 border-accent border-t-transparent animate-spin"></div>
        <p class="text-xs font-black uppercase tracking-widest text-slate-500 animate-pulse">Đang tải thông tin phim...</p>
    </div>
}
else if (MovieState.Value.SelectedMovie != null)
{
    var movie = MovieState.Value.SelectedMovie;
    <PageTitle>@movie.Title | RATE</PageTitle>

    <div class="flex flex-col gap-16 pb-24 animate-in fade-in duration-500">
        @* Hero Grid Layout *@
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            @* Poster Column *@
            <div class="lg:col-span-4 sticky top-24 space-y-6">
                <div class="relative w-full aspect-[2/3] overflow-hidden rounded-[2.5rem] border border-slate-900 bg-gradient-to-b from-slate-900 to-slate-950 shadow-2xl">
                    
                    @* Premium fallback placeholder *@
                    <div class="absolute inset-0 flex flex-col items-center justify-center p-8 text-center select-none bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950">
                        <div class="w-16 h-16 rounded-3xl bg-accent/15 border border-accent/30 flex items-center justify-center text-accent mb-4 animate-pulse">
                            <FluentIcon Value="@(new Size24.MoviesAndTv())" Color="Color.Accent" class="w-8 h-8" />
                        </div>
                        <span class="text-lg font-black text-white/95 tracking-wide uppercase line-clamp-2 px-4">@movie.Title</span>
                        <span class="text-xs text-white/40 font-bold mt-2 uppercase tracking-widest">Không có ảnh</span>
                    </div>

                    @* Poster Image *@
                    <img src="@movie.PosterUrl" 
                         onerror="this.style.opacity='0';"
                         class="absolute inset-0 z-10 w-full h-full object-cover transition-all duration-500" 
                         alt="@movie.Title" />
                </div>

                @* Sticky Booking Button (Netflix Red styled) *@
                <button class="w-full py-5 bg-[#e50914] hover:bg-[#b20710] !text-white text-sm font-black uppercase tracking-widest rounded-2xl shadow-xl shadow-[#e50914]/25 hover:shadow-[#e50914]/45 hover:scale-[1.02] transition-all duration-300 active:scale-95 cursor-pointer flex items-center justify-center gap-2 border-none" 
                        @onclick="@NavigateToBooking">
                    <FluentIcon Value="@(new Size20.Play())" Color="Color.Custom" CustomColor="#ffffff" class="w-5 h-5 flex items-center justify-center text-white" />
                    <span class="!text-white font-black">ĐẶT VÉ NGAY</span>
                </button>
            </div>

            @* Details Column *@
            <div class="lg:col-span-8 flex flex-col gap-10">
                <div class="space-y-6">
                    <div class="flex flex-wrap items-center gap-2">
                        @foreach (var genre in movie.Genres)
                        {
                            <span class="px-5 py-2 bg-accent/10 text-accent text-xs sm:text-sm font-extrabold rounded-full uppercase tracking-widest border border-accent/20">@genre.Name</span>
                        }
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tighter leading-tight text-slate-900 dark:text-white">@movie.Title</h1>
                    
                    @* Details Meta Bar *@
                    <div class="flex flex-wrap items-center gap-6 text-slate-500 dark:text-slate-400 font-bold text-xs sm:text-sm">
                        <div class="flex items-center gap-2">
                            <FluentIcon Value="@(new Size20.Calendar())" Color="Color.Neutral" class="w-5 h-5 text-slate-400" />
                            <span>@movie.Year</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <FluentIcon Value="@(new Size20.Star())" Color="Color.Warning" class="w-5 h-5" />
                            <span class="text-slate-900 dark:text-white text-base sm:text-lg font-black">@movie.Rating</span>
                            <span class="opacity-50">/ 10</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <FluentIcon Value="@(new Size20.Clock())" Color="Color.Neutral" class="w-5 h-5 text-slate-400" />
                            <span>145 phút</span>
                        </div>
                    </div>

                    <p class="text-lg sm:text-xl md:text-[21px] leading-relaxed text-slate-700 dark:text-slate-300 font-medium">@movie.Summary</p>
                </div>

                @* Actors / Cast Section *@
                <div class="pt-8 border-t border-slate-100 dark:border-slate-800/80 space-y-6">
                    <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tight flex items-center gap-3">
                        👥 Diễn viên chính
                    </h3>
                    
                    @if (isActorsLoading)
                    {
                        <div class="flex gap-6 overflow-x-auto pb-4">
                            @for (int i = 0; i < 4; i++)
                            {
                                <div class="flex flex-col items-center text-center gap-3 min-w-[120px] animate-pulse">
                                    <div class="w-24 h-24 rounded-full bg-slate-200 dark:bg-slate-800"></div>
                                    <div class="h-4 bg-slate-200 dark:bg-slate-800 rounded w-16"></div>
                                </div>
                            }
                        </div>
                    }
                    else if (actors.Any())
                    {
                        <div class="flex gap-6 overflow-x-auto pb-4 scrollbar-thin scrollbar-thumb-slate-300 dark:scrollbar-thumb-slate-800">
                            @foreach (var actor in actors)
                            {
                                <div class="flex flex-col items-center text-center gap-3 min-w-[120px] group cursor-pointer"
                                     @onclick="@(() => NavigationManager.NavigateTo($"/actors/{actor.Id}"))">
                                    <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-slate-100 dark:border-slate-800 shadow-md group-hover:scale-105 group-hover:border-accent transition-all duration-300 relative bg-slate-50 dark:bg-slate-950 flex items-center justify-center">
                                        @if (!string.IsNullOrEmpty(actor.PictureUrl))
                                        {
                                            <img src="@actor.PictureUrl" class="w-full h-full object-cover" alt="@actor.FullName" onerror="this.style.opacity='0';" />
                                        }
                                        else
                                        {
                                            <span class="text-2xl select-none">👤</span>
                                        }
                                    </div>
                                    <div class="space-y-0.5">
                                        <p class="text-xs font-black text-slate-900 dark:text-white group-hover:text-accent transition-colors line-clamp-1">@actor.FullName</p>
                                        <p class="text-[10px] text-slate-400 dark:text-slate-500 font-bold uppercase tracking-wider line-clamp-1">@(!string.IsNullOrEmpty(actor.Role) ? actor.Role : "Diễn viên")</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-slate-500 dark:text-slate-400 font-medium text-sm">Thông tin dàn diễn viên đang được cập nhật.</p>
                    }
                </div>

                @* Quick Action Ticket Section *@
                <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between gap-6">
                    <div class="text-left">
                        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white mb-2">Đã sẵn sàng trải nghiệm?</h2>
                        <p class="text-slate-500 dark:text-slate-400 font-medium text-sm sm:text-base">Đặt vé ngay bây giờ để chọn được vị trí ngồi đẹp nhất tại rạp chiếu.</p>
                    </div>
                    <button class="w-full sm:w-auto px-8 py-4.5 bg-accent hover:bg-accent-hover text-white text-sm font-black uppercase tracking-widest rounded-2xl shadow-xl shadow-accent/20 hover:scale-[1.02] transition-all duration-300 active:scale-95 cursor-pointer flex items-center justify-center gap-2"
                            @onclick="@NavigateToBooking">
                        <FluentIcon Value="@(new Size20.TicketDiagonal())" Color="Color.Fill" class="w-5 h-5 flex items-center justify-center text-white" />
                        <span>MUA VÉ NGAY</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private List<PersonDto> actors = new();
    private bool isActorsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        Dispatcher.Dispatch(new LoadMovieByIdAction(Id));
        
        try
        {
            isActorsLoading = true;
            var response = await PersonApi.GetByMovieAsync(Id);
            actors = response?.Body ?? new List<PersonDto>();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading actors: " + ex.Message);
        }
        finally
        {
            isActorsLoading = false;
        }
    }

    private void NavigateToBooking()
    {
        // 1. Reset state workflow giỏ hàng
        Dispatcher.Dispatch(new WebUI.Shared.Store.Bookings.StartBookingAction(Id));
        
        // 2. Chuyển sang màn chọn suất chiếu
        NavigationManager.NavigateTo($"/book/showtimes/{Id}");
    }
}
