@using MudBlazor

@if (IsLoading)
{
    <div class="rate-state rate-state-loading">
        <MudProgressCircular Color="MudBlazor.Color.Primary" Indeterminate="true" />
        <span>@LoadingMessage</span>
    </div>
}
else if (!string.IsNullOrEmpty(Error))
{
    <div class="rate-state rate-state-error">
        <MudIcon Icon="@MudBlazor.Icons.Material.Outlined.ErrorOutline" Size="MudBlazor.Size.Large" Color="MudBlazor.Color.Error" />
        <h3>Không thể tải dữ liệu</h3>
        <p>@ErrorMessage</p>
        @if (OnRetry.HasDelegate)
        {
            <MudButton Variant="MudBlazor.Variant.Outlined" Color="MudBlazor.Color.Primary" OnClick="OnRetry">Thử lại</MudButton>
        }
    </div>
}
else if (IsEmpty)
{
    <div class="rate-state rate-state-empty">
        <MudIcon Icon="@MudBlazor.Icons.Material.Outlined.Inbox" Size="MudBlazor.Size.Large" Color="MudBlazor.Color.Default" />
        <h3>Không tìm thấy dữ liệu</h3>
        <p>@EmptyMessage</p>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string LoadingMessage { get; set; } = "Đang tải dữ liệu...";
    [Parameter] public string EmptyMessage { get; set; } = "Hiện chưa có dữ liệu để hiển thị.";
    [Parameter] public string ErrorMessage { get; set; } = "Dữ liệu chưa sẵn sàng. Vui lòng thử lại sau.";
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
