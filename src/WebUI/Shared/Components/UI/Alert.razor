<div class="@GetAlertClass()" role="alert">
    @if (Variant == "destructive")
    {
        <svg class="h-4 w-4 text-destructive shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
    }
    else
    {
        <svg class="h-4 w-4 text-foreground shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
    }
    <div class="flex flex-col gap-1">
        @if (!string.IsNullOrEmpty(Title))
        {
            <h5 class="font-medium leading-none tracking-tight">@Title</h5>
        }
        <div class="text-sm [&_p]:leading-relaxed">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public string Variant { get; set; } = "default"; // default, destructive
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string GetAlertClass()
    {
        var baseClass = "relative w-full rounded-lg border p-4 flex gap-3 [&>svg~div]:translate-y-[-3px]";
        var variantClass = Variant == "destructive"
            ? "border-destructive/50 text-destructive bg-destructive/10 dark:border-destructive [&>svg]:text-destructive"
            : "bg-background text-foreground border-border";

        return $"{baseClass} {variantClass} {Class}".Trim();
    }
}