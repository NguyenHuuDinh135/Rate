@implements IDisposable
@inject IAdminThemeService ThemeService
@inject IJSRuntime JSRuntime

<button type="button"
        class="@ButtonClass"
        aria-label="@AriaLabel"
        title="@AriaLabel"
        @onclick="ToggleTheme">
    <div class="relative w-5 h-5 flex items-center justify-center transition-transform duration-500 ease-out transform group-hover:rotate-45">
        <Blazicon Svg="@(ThemeService.IsDarkMode ? Lucide.Sun : Lucide.Moon)" class="w-5 h-5 transition-colors duration-300" />
    </div>
</button>

@code {
    [Parameter] public string? Class { get; set; }

    private string AriaLabel => ThemeService.IsDarkMode ? "Chuyển sang giao diện sáng" : "Chuyển sang giao diện tối";

    private string ButtonClass =>
        ("rate-theme-toggle relative group inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200/80 bg-white/70 text-slate-700 shadow-sm transition-all duration-300 backdrop-blur-sm " +
         "hover:bg-slate-50 hover:text-slate-950 hover:border-slate-300 hover:shadow-md active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 " +
         "dark:border-slate-800/80 dark:bg-slate-950/70 dark:text-slate-300 dark:hover:bg-slate-900/80 dark:hover:text-white dark:hover:border-red-500/50 dark:hover:shadow-[0_0_15px_rgba(229,9,20,0.15)] " +
         Class).Trim();

    protected override async Task OnInitializedAsync()
    {
        ThemeService.ThemeChanged += HandleThemeChanged;

        try
        {
            // Early synchronization in WASM (no-prerender) to completely eliminate theme flicker
            var isDarkMode = await JSRuntime.InvokeAsync<bool>("rateTheme.init", ThemeService.IsDarkMode);
            ThemeService.SetDarkMode(isDarkMode);
        }
        catch
        {
            // Ignore failure on server-side or prerender
        }
    }

    private async Task ToggleTheme()
    {
        ThemeService.Toggle();

        try
        {
            await JSRuntime.InvokeVoidAsync("rateTheme.set", ThemeService.IsDarkMode);
        }
        catch
        {
            // Ignore JS failures during prerender or disconnected circuits.
        }
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
    }
}
