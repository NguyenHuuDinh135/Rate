@using WebUI.Shared.Models.Movies
@using WebUI.Shared.Models.Common

<section class="max-w-[1440px] mx-auto px-[5%] py-12 select-none text-left transition-colors duration-300">
    
    @* Section Header *@
    <div class="flex justify-between items-center mb-8 border-b border-slate-200 dark:border-white/5 pb-4">
        <h2 class="text-xl sm:text-2xl font-black flex items-center gap-3 italic text-slate-800 dark:text-white uppercase tracking-wide">
            <span class="text-[#e50914] text-2xl sm:text-3xl not-italic">@Icon</span>
            @Title
        </h2>

        @if (ShowNavigationButtons)
        {
            <div class="flex gap-2">
                <button type="button" class="w-10 h-10 rounded-full border border-slate-200 hover:bg-slate-100 text-slate-500 hover:text-slate-900 dark:border-white/10 dark:text-[#a0a0a0] dark:hover:text-white dark:hover:bg-[#202020] dark:hover:border-white/20 transition-all duration-300 cursor-pointer text-lg font-bold flex items-center justify-center">
                    ‹
                </button>
                <button type="button" class="w-10 h-10 rounded-full border border-slate-200 hover:bg-slate-100 text-slate-500 hover:text-slate-900 dark:border-white/10 dark:text-[#a0a0a0] dark:hover:text-white dark:hover:bg-[#202020] dark:hover:border-white/20 transition-all duration-300 cursor-pointer text-lg font-bold flex items-center justify-center">
                    ›
                </button>
            </div>
        }
    </div>

    @* Movie Grid *@
    <div class="grid @GridClass gap-6 sm:gap-8">
        @foreach (var movie in Movies)
        {
            <MovieCard Title="@movie.Title"
                       Year="@movie.Year.ToString()"
                       Type="@(movie.Genres.Any() ? string.Join(", ", movie.Genres.Take(2).Select(g => g.Name)) : "Phim rạp")"
                       Rating="@(movie.Rating.HasValue ? movie.Rating.Value.ToString("0.0") : "TBA")"
                       PosterUrl="@movie.PosterUrl"
                       IsUpcoming="@(movie.MovieType == MovieType.ComingSoon || !movie.Rating.HasValue)"
                       OnClick="@(() => HandleMovieClick(movie))" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Icon { get; set; } = "▷";

    [Parameter]
    public string GridClass { get; set; } = "grid-cols-2 sm:grid-cols-3 md:grid-cols-5";

    [Parameter]
    public bool ShowNavigationButtons { get; set; } = true;

    [Parameter, EditorRequired]
    public List<MovieDto> Movies { get; set; } = new();

    [Parameter]
    public EventCallback<MovieDto> OnMovieSelected { get; set; }

    private async Task HandleMovieClick(MovieDto movie)
    {
        if (OnMovieSelected.HasDelegate)
        {
            await OnMovieSelected.InvokeAsync(movie);
        }
    }
}
