<footer class="bg-slate-100 border-t border-slate-200 text-slate-600 dark:bg-[#0e0e0e] dark:border-white/10 dark:text-[#a0a0a0] pt-16 pb-8 transition-colors duration-300">
    <div class="max-w-[1440px] mx-auto px-[5%]">
        
        @* 4 Column Grid *@
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 mb-12 text-left">
            
            @* Col 1: Brand & Desc *@
            <div class="space-y-4">
                <a href="/" class="text-slate-800 hover:text-[#e50914] dark:text-white dark:hover:text-[#e50914] text-xl font-bold flex items-center gap-2 transition-colors duration-300">
                    <span class="text-[#e50914] text-2xl">📽</span>
                    <span>Cinema Booking</span>
                </a>
                <p class="text-xs sm:text-sm leading-relaxed">
                    Your ultimate destination for booking movie tickets online. Fast, easy, and secure.
                </p>
            </div>

            @* Col 2: Quick Links *@
            <div class="space-y-4">
                <h3 class="text-slate-800 dark:text-white font-bold text-xs uppercase tracking-widest border-l-2 border-[#e50914] pl-2.5">Quick Links</h3>
                <ul class="space-y-2.5 text-xs sm:text-sm">
                    <li><a href="/movies" class="hover:text-[#e50914] transition-colors duration-300">Movies</a></li>
                    <li><a href="/theaters" class="hover:text-[#e50914] transition-colors duration-300">Theaters</a></li>
                    <li><a href="/explore" class="hover:text-[#e50914] transition-colors duration-300">Explore</a></li>
                    <li><a href="/about" class="hover:text-[#e50914] transition-colors duration-300">About</a></li>
                </ul>
            </div>

            @* Col 3: Support *@
            <div class="space-y-4">
                <h3 class="text-slate-800 dark:text-white font-bold text-xs uppercase tracking-widest border-l-2 border-[#e50914] pl-2.5">Support</h3>
                <ul class="space-y-2.5 text-xs sm:text-sm">
                    <li><a href="#" class="hover:text-[#e50914] transition-colors duration-300">Help Center</a></li>
                    <li><a href="#" class="hover:text-[#e50914] transition-colors duration-300">Terms of Service</a></li>
                    <li><a href="#" class="hover:text-[#e50914] transition-colors duration-300">Privacy Policy</a></li>
                    <li><a href="#" class="hover:text-[#e50914] transition-colors duration-300">Contact Us</a></li>
                </ul>
            </div>

            @* Col 4: Contact *@
            <div class="space-y-4">
                <h3 class="text-slate-800 dark:text-white font-bold text-xs uppercase tracking-widest border-l-2 border-[#e50914] pl-2.5">Contact</h3>
                <ul class="space-y-2.5 text-xs sm:text-sm">
                    <li class="flex items-center gap-2"><span>📍</span> Da Nang, Vietnam</li>
                    <li class="flex items-center gap-2"><span>✉</span> <a href="mailto:contact@cinema.vn" class="hover:text-[#e50914] transition-colors">contact@cinema.vn</a></li>
                    <li class="flex items-center gap-2"><span>💻</span> <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#e50914] transition-colors">GitHub</a></li>
                </ul>
            </div>
        </div>

        @* Bottom Copyright *@
        <div class="border-t border-slate-200/50 dark:border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center text-xs gap-4">
            <p class="text-center md:text-left">
                Built by <span class="text-slate-800 dark:text-white font-semibold">Gọi Tên Em Đi</span> at <span class="text-slate-800 dark:text-white font-semibold">UTE</span>. The source code is available on <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-[#e50914] hover:underline font-semibold">GitHub</a>.
            </p>
            <p>© 2025 Cinema Booking. All rights reserved.</p>
        </div>
    </div>
</footer>

