<div class="rate-page-header">
    <div>
        <p class="rate-page-header__eyebrow">@Eyebrow</p>
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="rate-page-header__description">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="rate-page-header__actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Eyebrow { get; set; } = "RATE Admin";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
