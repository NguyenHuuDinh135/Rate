@page "/explore"
@using WebFrontend.Shared.Models.Movies
@using WebFrontend.Shared.Services.Api
@using WebFrontend.Shared.Components
@using Microsoft.FluentUI.AspNetCore.Components
@inject IMovieApi MovieApi
@inject IToastService ToastService

<PageTitle>Khám phá | RATE</PageTitle>

<div class="fixed inset-0 bg-black z-40">
    @if (isLoading)
    {
        <div class="h-full w-full flex flex-col items-center justify-center text-white gap-4">
            <FluentProgressRing />
            <p class="text-sm font-black uppercase tracking-widest opacity-50">Đang tải phim mới...</p>
        </div>
    }
    else if (movies.Any())
    {
        @* Scroll Container *@
        <div @ref="scrollContainer" 
             class="h-full w-full overflow-y-auto snap-y snap-mandatory scrollbar-hide"
             @onscroll="HandleScroll">
            @for (int i = 0; i < movies.Count; i++)
            {
                var index = i;
                <div class="h-full w-full snap-start shrink-0">
                    <ReelItem Movie="@movies[index]" 
                              IsActive="@(index == activeIndex)" 
                              IsMuted="@isMuted"
                              OnToggleMute="@(() => isMuted = !isMuted)" />
                </div>
            }
        </div>

        @* Scroll Hint *@
        @if (activeIndex == 0)
        {
            <div class="fixed bottom-10 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center animate-bounce text-white/50 pointer-events-none">
                <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.ChevronDown())" />
                <span class="text-[10px] font-black uppercase tracking-widest mt-2">Lướt để khám phá</span>
            </div>
        }
    }
</div>

@code {
    private List<MovieDto> movies = new();
    private bool isLoading = true;
    private int activeIndex = 0;
    private bool isMuted = true;
    private ElementReference scrollContainer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allMovies = await MovieApi.GetAllAsync();
            movies = allMovies.Where(m => !string.IsNullOrEmpty(m.TrailerUrl)).OrderBy(_ => Guid.NewGuid()).ToList();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Không thể tải danh sách khám phá: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleScroll(EventArgs e)
    {
        // Simple scroll logic for Blazor without JS Interop for now
        // In a real app, we would use Intersection Observer via JS
    }
}
