@using WebFrontend.Shared.Models.Payments
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Regular

<div class="group relative flex flex-col md:flex-row bg-white border border-slate-100 rounded-[2.5rem] overflow-hidden hover:shadow-2xl transition-all duration-500 hover:-translate-y-1">
    @* Left: Poster *@
    <div class="md:w-52 h-64 md:h-auto relative overflow-hidden shrink-0">
        <img src="@(Payment.Movie?.PosterUrl ?? "https://via.placeholder.com/200x300")" 
             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" alt="@Payment.Movie?.Title" />
        <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
        <div class="absolute top-6 left-6">
            <FluentBadge Appearance="Appearance.Accent" class="px-3 py-1 font-black shadow-lg">PAID</FluentBadge>
        </div>
    </div>

    @* Middle: Content *@
    <div class="flex-1 p-8 flex flex-col justify-between relative">
        @* Tear cutouts *@
        <div class="hidden md:block absolute -top-4 -right-4 w-8 h-8 bg-slate-50 rounded-full border border-slate-100"></div>
        <div class="hidden md:block absolute -bottom-4 -right-4 w-8 h-8 bg-slate-50 rounded-full border border-slate-100"></div>

        <div class="space-y-6">
            <div>
                <h3 class="text-2xl font-black text-slate-900 group-hover:text-accent transition-colors leading-tight">
                    @Payment.Movie?.Title
                </h3>
                <p class="text-[10px] text-slate-400 font-black uppercase tracking-widest mt-1">Đơn hàng #@(Payment.PaymentId.ToString().PadLeft(6, '0'))</p>
            </div>
            
            <div class="grid grid-cols-2 gap-y-4 gap-x-8 text-sm font-bold text-slate-500">
                <div class="flex items-center gap-3">
                    <FluentIcon Value="@(new Size20.Calendar())" Color="Color.Accent" />
                    <span>18 Tháng 12, 2025</span>
                </div>
                <div class="flex items-center gap-3">
                    <FluentIcon Value="@(new Size20.Clock())" Color="Color.Accent" />
                    <span>19:30</span>
                </div>
                <div class="flex items-center gap-3 col-span-2">
                    <FluentIcon Value="@(new Size20.Map())" Color="Color.Accent" />
                    <span class="truncate">Phòng 04 • Lotte Cinema Hà Đông</span>
                </div>
            </div>
        </div>

        <div class="mt-8 pt-6 border-t border-dashed border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest">Thanh toán</span>
                <span class="text-xl font-black text-slate-900">@Payment.Amount.ToString("N0") đ</span>
            </div>
            <div class="flex gap-2">
                <FluentAnchor Href="@($"/booking/{Payment.PaymentId}")" Appearance="Appearance.Stealth" class="h-10 px-4 rounded-xl font-bold">Chi tiết</FluentAnchor>
                <FluentAnchor Href="@($"/booking/{Payment.PaymentId}")" Appearance="Appearance.Accent" IconStart="@(new Size20.QrCode())" class="h-10 px-4 rounded-xl font-bold shadow-lg shadow-accent/10">Vé QR</FluentAnchor>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PaymentDto Payment { get; set; } = default!;
}
