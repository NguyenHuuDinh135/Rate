@using WebFrontend.Shared.Models.Theaters
@using WebFrontend.Shared.Models.Bookings
@using Microsoft.FluentUI.AspNetCore.Components

<div class="relative w-full flex flex-col items-center">
    @* Screen Visualization *@
    <div class="w-2/3 mb-12 relative">
        <div class="h-2 w-full bg-accent rounded-full shadow-[0_0_30px_10px_rgba(var(--accent-rgb),0.4)]" style="border-radius: 50%;"></div>
        <div class="absolute top-6 w-full text-center text-[10px] text-accent font-bold tracking-[0.5em] uppercase opacity-70">MÀN HÌNH</div>
    </div>

    @* Seat Grid *@
    <div class="overflow-x-auto max-w-full pb-8 px-4 w-full flex justify-center">
        <div class="flex flex-col gap-2 min-w-max">
            @for (int i = 0; i < Theater.NumOfRows; i++)
            {
                var rowChar = (char)('A' + i);
                <div class="flex gap-2 items-center justify-center">
                    <span class="w-6 text-center text-[10px] text-muted-foreground font-bold">@rowChar</span>
                    
                    @for (int j = 1; j <= Theater.SeatsPerRow; j++)
                    {
                        var seatCode = $"{rowChar}{j}";
                        var isMissing = Theater.Missing?.Any(s => s.SeatRow == rowChar.ToString() && s.SeatNumber == j) ?? false;
                        var isBlocked = Theater.Blocked?.Any(s => s.SeatRow == rowChar.ToString() && s.SeatNumber == j) ?? false;
                        var isOccupied = BookedSeats.Any(s => s.SeatRow == rowChar.ToString() && s.SeatNumber == j);
                        var isSelected = SelectedSeats.Contains(seatCode);

                        @if (isMissing)
                        {
                            <div class="w-6 h-6 md:w-8 md:h-8 opacity-0 pointer-events-none"></div>
                        }
                        else
                        {
                            var seatClass = GetSeatClass(isBlocked, isOccupied, isSelected);
                            <button disabled="@(isBlocked || isOccupied)" 
                                    @onclick="() => OnToggleSeat.InvokeAsync(seatCode)"
                                    class="@seatClass transition-all duration-300 transform hover:scale-110 active:scale-95">
                                <span class="@(isSelected ? "opacity-100" : "opacity-0 group-hover:opacity-100")">@j</span>
                            </button>
                        }
                    }

                    <span class="w-6 text-center text-[10px] text-muted-foreground font-bold">@rowChar</span>
                </div>
            }
        </div>
    </div>

    @* Legend *@
    <div class="flex flex-wrap justify-center gap-6 text-[10px] uppercase tracking-wider font-bold w-full max-w-2xl border-t border-border pt-8 mt-4">
        <div class="flex items-center gap-2">
            <div class="w-4 h-4 rounded-md bg-white border border-border shadow-sm"></div>
            <span class="text-muted-foreground">Còn trống</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="w-4 h-4 rounded-md bg-accent shadow-lg shadow-accent/40 border-accent"></div>
            <span class="text-foreground">Đang chọn</span>
        </div>
        <div class="flex items-center gap-2">
            <div class="w-4 h-4 rounded-md bg-slate-200 border-transparent"></div>
            <span class="text-muted-foreground opacity-50">Đã đặt / Khóa</span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TheaterDto Theater { get; set; } = default!;
    [Parameter] public List<BookedSeatDto> BookedSeats { get; set; } = new();
    [Parameter] public List<string> SelectedSeats { get; set; } = new();
    [Parameter] public EventCallback<string> OnToggleSeat { get; set; }

    private string GetSeatClass(bool isBlocked, bool isOccupied, bool isSelected)
    {
        var baseClass = "group w-6 h-6 md:w-8 md:h-8 rounded-t-lg rounded-b-sm flex items-center justify-center text-[9px] font-black border ";
        
        if (isBlocked || isOccupied)
            return baseClass + "bg-slate-200 text-slate-400 cursor-not-allowed border-transparent opacity-40";
        
        if (isSelected)
            return baseClass + "bg-accent text-white shadow-xl shadow-accent/40 z-10 border-accent scale-110";
            
        return baseClass + "bg-white hover:bg-accent/10 hover:border-accent/50 cursor-pointer text-accent/0 hover:text-accent/60 border-border shadow-sm";
    }
}
